---
import BaseLayout from '../layouts/BaseLayout.astro';
import siteData from '../data/siteData.json';
---

<BaseLayout title="Home" description="ViYukti - Architecting Multi-Industry Excellence">
	<main class="min-h-screen bg-brand-dark flex flex-col items-center justify-center p-6 text-center">
		<h1 class="text-6xl font-bold mb-4 bg-clip-text text-transparent bg-gradient-to-r from-blue-400 to-emerald-400">
			ViYukti
		</h1>
		<p class="text-zinc-400 text-xl mb-12 max-w-2xl">
			One Brand. Six Industries. Infinite Excellence.
		</p>

		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl w-full">
			{Object.values(siteData.services).map((service) => (
				<a 
					href={`/services/${service.slug}`}
					class="group p-8 rounded-3xl border border-white/10 bg-white/[0.02] hover:bg-white/[0.05] transition-all duration-500 text-left relative overflow-hidden"
				>
					<div class="relative z-10">
						<h3 class="text-2xl font-bold mb-2 group-hover:text-blue-400 transition-colors">
							{service.title}
						</h3>
						<p class="text-zinc-500 text-sm leading-relaxed">
							{service.hero.subtitle}
						</p>
					</div>
					<div class="absolute bottom-0 right-0 p-4 opacity-20 group-hover:opacity-100 transition-opacity">
						<span class="text-4xl">→</span>
					</div>
				</a>
			))}
		</div>
	</main>
</BaseLayout>
