---
import BaseLayout from '../layouts/BaseLayout.astro';
import siteData from '../data/siteData.json';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import { Image } from 'astro:assets';
import homeBg from '../assets/home.jpg';
import realestateBg from '../assets/realestate.jpg';
import recruitmentBg from '../assets/recruitment and staffing.jpg';
import giftingBg from '../assets/gifting.jpg';
import marketingBg from '../assets/Digital marketing.jpg';
import itBg from '../assets/it dev and support.jpg';
import { ChevronRight, CheckCircle2, Phone, Mail, MessageSquare, Plus } from 'lucide-astro';

const heroSlides = [
  { img: homeBg, label: "Enterprise Solutions" },
  { img: realestateBg, label: "Real Estate Brokerage" },
  { img: recruitmentBg, label: "Recruitment & Staffing" },
  { img: giftingBg, label: "Corporate Gifting Solutions" },
  { img: marketingBg, label: "Digital Marketing" },
  { img: itBg, label: "IT Development & Support" }
];

// Safely access data
const getSafe = (obj: any, path: string, fallback: any = "") => {
  return path.split('.').reduce((acc, part) => acc && acc[part], obj) || fallback;
};

const homePage = siteData.homePage || {};
const hero = homePage.hero || {};
const whyChoose = homePage.whyChoose || [];
const whoWeAre = homePage.whoWeAre || {};
const whyPartner = homePage.whyPartner || { cards: [], statsBar: [] };
const howWeWork = homePage.howWeWork || [];
const counters = homePage.counters || [];
const industries = homePage.industries || [];
const faqs = homePage.faqs || [];

const services = Object.values(siteData.services || {});

const serviceImageMap: Record<string, any> = {
  'recruitment': recruitmentBg,
  'digital_marketing': marketingBg,
  'it_development': itBg,
  'corporate_gifting': giftingBg,
  'real_estate': realestateBg,
  'solar_services': homeBg
};
---

<BaseLayout title="Home" description={getSafe(hero, 'subtitle')} bgImage={homeBg}>
	<Navigation />
	
	<!-- Hero Section -->
	<header class="relative min-h-[95vh] flex items-center justify-center pt-32 pb-16 overflow-hidden">
		<!-- Background Glows -->
		<div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-white/[0.02] rounded-full blur-[120px] pointer-events-none"></div>
		
		<div class="w-full max-w-7xl mx-auto px-6 relative z-10 text-center">
			<!-- Premium Widescreen Auto-Slider Section -->
			<div class="relative w-full h-[260px] sm:h-[450px] md:h-[600px] rounded-[2rem] md:rounded-[2.5rem] overflow-hidden border border-white/10 shadow-2xl mb-16 bg-zinc-950/80 select-none">
				{heroSlides.map((slide, index) => (
					<div class={`absolute inset-0 transition-opacity duration-1000 ease-in-out hero-slide ${index === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0'}`} data-index={index}>
						<Image src={slide.img} alt={slide.label} class="w-full h-full object-cover scale-105 transition-transform duration-[5000ms] ease-out slide-image" />
						<div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/35 to-transparent"></div>
						<div class="absolute bottom-6 left-8 text-left z-20">
							<span class="px-4 py-1.5 rounded-full border border-white/10 bg-black/60 backdrop-blur-md text-[10px] font-bold uppercase tracking-widest text-zinc-300">
								{slide.label}
							</span>
						</div>
					</div>
				))}
				
				<!-- Slider controls (dots) -->
				<div class="absolute bottom-6 right-8 flex gap-2.5 z-20">
					{heroSlides.map((_, index) => (
						<button 
							class={`w-2.5 h-2.5 rounded-full transition-all duration-300 slider-dot ${index === 0 ? 'bg-white w-6' : 'bg-white/30 hover:bg-white/50'}`}
							data-index={index}
							aria-label={`Go to slide ${index + 1}`}
						/>
					))}
				</div>
			</div>

			<span class="inline-block px-4 py-1.5 rounded-full text-xs font-semibold tracking-widest uppercase border border-white/10 mb-8 bg-white/5 text-zinc-400 gsap-reveal">
				{siteData.domain}
			</span>
			<h1 class="text-5xl md:text-7xl lg:text-8xl font-black tracking-tighter mb-8 max-w-5xl mx-auto leading-[1.05]">
				{getSafe(hero, 'title')}
			</h1>
			<p class="text-xl md:text-2xl text-zinc-400 max-w-3xl mx-auto mb-12 leading-relaxed gsap-reveal">
				{getSafe(hero, 'subtitle')}
			</p>
			<p class="text-lg text-zinc-500 max-w-2xl mx-auto mb-12 gsap-reveal italic">
				{getSafe(hero, 'description')}
			</p>
			
			<div class="flex flex-col sm:flex-row gap-5 justify-center gsap-reveal">
				<a href="/contact-us" class="px-10 py-5 rounded-full bg-white text-black font-bold tracking-widest uppercase text-sm hover:scale-105 transition-transform duration-300 flex items-center justify-center gap-2">
					Get Free Consultation <ChevronRight size={18} />
				</a>
				<a href="#sectors" class="px-10 py-5 rounded-full border border-white/10 bg-white/5 backdrop-blur-md font-bold tracking-widest uppercase text-sm hover:bg-white/10 transition-all duration-300">
					Explore Services
				</a>
			</div>

			<div class="mt-20 grid grid-cols-2 md:grid-cols-5 gap-4 max-w-4xl mx-auto opacity-50">
				{whyChoose.map(item => (
					<div class="text-[10px] font-bold tracking-widest uppercase border border-white/10 py-2 rounded-full">
						{item}
					</div>
				))}
			</div>
		</div>
	</header>

	<!-- Who We Are Section -->
	<section class="py-32 border-t border-white/5 bg-zinc-950 relative overflow-hidden">
		<div class="container mx-auto px-6">
			<div class="grid lg:grid-cols-2 gap-20 items-center">
				<div class="gsap-reveal">
					<span class="text-xs font-bold tracking-[0.3em] uppercase text-zinc-500 mb-6 block">{getSafe(whoWeAre, 'title')}</span>
					<h2 class="text-4xl md:text-6xl font-black mb-8 leading-tight">{getSafe(whoWeAre, 'subtitle')}</h2>
					<p class="text-xl text-zinc-400 mb-8 leading-relaxed">
						{getSafe(whoWeAre, 'description')}
					</p>
					<p class="text-zinc-500 mb-8 leading-relaxed">
						{getSafe(whoWeAre, 'extendedDescription')}
					</p>
					<div class="p-8 rounded-3xl bg-white/[0.02] border border-white/5 italic text-zinc-400 border-l-4 border-l-white/20">
						"{getSafe(whoWeAre, 'approach')}"
					</div>
				</div>
				<div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
					{(whoWeAre.reasons || []).map((reason) => (
						<div class="who-we-are-card p-8 rounded-3xl border border-white/5 bg-white/[0.01] flex flex-col justify-between">
							<CheckCircle2 class="text-zinc-600 mb-6" size={32} />
							<h4 class="text-lg font-bold text-zinc-300">{reason}</h4>
						</div>
					))}
					<div class="sm:col-span-2 p-8 rounded-3xl bg-white text-black gsap-reveal">
						<h4 class="text-2xl font-black mb-2">Different by Design.</h4>
						<p class="text-black/70">{getSafe(whoWeAre, 'differentiation')}</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Leadership Quote Section -->
	<section class="py-40 bg-white text-black relative overflow-hidden">
		<div class="container mx-auto px-6 text-center relative z-10">
			<div class="max-w-5xl mx-auto">
				<svg class="w-20 h-20 text-black/10 mx-auto mb-12" fill="currentColor" viewBox="0 0 24 24"><path d="M14.017 21L14.017 18C14.017 16.8954 14.9124 16 16.017 16H19.017C19.5693 16 20.017 15.5523 20.017 15V9C20.017 8.44772 19.5693 8 19.017 8H15.017C14.4647 8 14.017 8.44772 14.017 9V12C14.017 12.5523 13.5693 13 13.017 13H11.017C10.4647 13 10.017 12.5523 10.017 12V9C10.017 7.89543 10.9124 7 12.017 7H19.017C20.1216 7 21.017 7.89543 21.017 9V15C21.017 18.3137 18.3307 21 15.017 21H14.017ZM3.017 21L3.017 18C3.017 16.8954 3.91243 16 5.017 16H8.017C8.56928 16 9.017 15.5523 9.017 15V9C9.017 8.44772 8.56928 8 8.017 8H4.017C3.46472 8 3.017 8.44772 3.017 9V12C3.017 12.5523 2.56928 13 2.017 13H0.017C-0.535282 13 -1.017 12.5523 -1.017 12V9C-1.017 7.89543 -0.121573 7 0.982999 7H8.017C9.12157 7 10.017 7.89543 10.017 9V15C10.017 18.3137 7.33072 21 4.017 21H3.017Z"/></svg>
				<h2 class="text-4xl md:text-6xl font-black tracking-tight mb-12 italic leading-tight gsap-reveal">
					"{getSafe(homePage, 'leadershipQuote.text')}"
				</h2>
				<div class="h-1 w-20 bg-black/20 mx-auto mb-8"></div>
				<p class="font-bold tracking-[0.3em] uppercase text-sm">— {getSafe(homePage, 'leadershipQuote.author')}</p>
			</div>
		</div>
	</section>

	<!-- Premium Sectors Grid -->
	<section id="sectors" class="py-32 relative">
		<div class="container mx-auto px-6">
			<div class="text-center mb-20 gsap-reveal">
				<span class="text-xs font-bold tracking-[0.3em] uppercase text-zinc-500 mb-6 block">Our Services</span>
				<h2 class="text-4xl md:text-6xl font-black mb-8 leading-tight">Comprehensive Solutions Under One Roof</h2>
				<p class="text-zinc-500 max-w-2xl mx-auto">Explore specialized services engineered for industry leadership and measurable growth.</p>
			</div>

			<!-- Infinite Draggable Services Slider -->
			<div 
				id="services-slider-container" 
				class="overflow-x-auto scrollbar-none cursor-grab active:cursor-grabbing select-none w-full gsap-reveal"
			>
				<div 
					id="services-slider-track" 
					class="flex gap-8 w-max py-6 px-4"
				>
					{/* First set of cards */}
					{services.map((service: any, index) => {
						const accentColor = {
							'recruitment': '#3b82f6',
							'digital_marketing': '#a855f7',
							'it_development': '#06b6d4',
							'corporate_gifting': '#fec624',
							'real_estate': '#f59e0b',
							'solar_services': '#10b981'
						}[service.id] || '#1ea99a';

						return (
							<div 
								class="group rounded-[2.5rem] border border-white/5 bg-white/[0.01] hover:bg-white/[0.02] hover:border-white/20 transition-all duration-500 relative overflow-hidden flex flex-col h-[520px] shrink-0 w-[85vw] sm:w-[380px] md:w-[420px]"
							>
								<!-- Image Header Container -->
								<div class="relative h-56 overflow-hidden rounded-t-[2.5rem] shrink-0">
									<Image 
										src={serviceImageMap[service.id]} 
										alt={service.title} 
										class="w-full h-full object-cover transition-transform duration-[3s] group-hover:scale-110 pointer-events-none" 
									/>
									<div class="absolute inset-0 bg-gradient-to-t from-[#2f2940] via-black/35 to-transparent"></div>
									<span class="absolute top-6 left-8 text-3xl font-black text-white/30 group-hover:text-white/60 transition-colors">0{index + 1}</span>
									
									<!-- Dynamic border accent line -->
									<div class="absolute bottom-0 left-0 w-full h-1" style={`background-color: ${accentColor}`}></div>
								</div>

								<!-- Content Container -->
								<div class="p-8 md:p-10 flex flex-col flex-grow relative z-10">
									<h3 class="text-2xl font-black mb-4 text-white transition-colors duration-300" style={`--hover-color: ${accentColor}`}>
										{service.title}
									</h3>
									
									<p class="text-zinc-400 text-sm leading-relaxed mb-8">
										{service.hero?.subtitle}
									</p>

									<div class="mt-auto space-y-4">
										<p class="text-[10px] font-bold tracking-widest uppercase text-zinc-500">Services Include:</p>
										<div class="flex flex-wrap gap-2">
											{(service.servicesInclude || []).slice(0, 3).map((item: string) => (
												<span class="px-3 py-1 rounded-full border border-white/5 bg-white/5 text-[10px] text-zinc-300">
													{item}
												</span>
											))}
										</div>

										<div class="pt-6 border-t border-white/5 flex justify-between items-center">
											<a href={`/services/${service.slug}`} class="inline-flex items-center gap-2 text-xs font-bold tracking-widest uppercase text-white hover:text-white/80 transition-colors group/link">
												{service.cta || 'Learn More'} <ChevronRight size={14} class="text-zinc-500 group-hover/link:text-white" />
											</a>
											<a href={`/services/${service.slug}`} class="w-10 h-10 rounded-full border border-white/10 flex items-center justify-center bg-white/5 group-hover:bg-[#1ea99a] group-hover:text-white group-hover:border-[#1ea99a] transition-all">
												<ChevronRight size={18} />
											</a>
										</div>
									</div>
								</div>
							</div>
						);
					})}
					{/* Cloned set of cards for seamless infinite wrap */}
					{services.map((service: any, index) => {
						const accentColor = {
							'recruitment': '#3b82f6',
							'digital_marketing': '#a855f7',
							'it_development': '#06b6d4',
							'corporate_gifting': '#fec624',
							'real_estate': '#f59e0b',
							'solar_services': '#10b981'
						}[service.id] || '#1ea99a';

						return (
							<div 
								class="group rounded-[2.5rem] border border-white/5 bg-white/[0.01] hover:bg-white/[0.02] hover:border-white/20 transition-all duration-500 relative overflow-hidden flex flex-col h-[520px] shrink-0 w-[85vw] sm:w-[380px] md:w-[420px]"
							>
								<!-- Image Header Container -->
								<div class="relative h-56 overflow-hidden rounded-t-[2.5rem] shrink-0">
									<Image 
										src={serviceImageMap[service.id]} 
										alt={service.title} 
										class="w-full h-full object-cover transition-transform duration-[3s] group-hover:scale-110 pointer-events-none" 
									/>
									<div class="absolute inset-0 bg-gradient-to-t from-[#2f2940] via-black/35 to-transparent"></div>
									<span class="absolute top-6 left-8 text-3xl font-black text-white/30 group-hover:text-white/60 transition-colors">0{index + 1}</span>
									
									<!-- Dynamic border accent line -->
									<div class="absolute bottom-0 left-0 w-full h-1" style={`background-color: ${accentColor}`}></div>
								</div>

								<!-- Content Container -->
								<div class="p-8 md:p-10 flex flex-col flex-grow relative z-10">
									<h3 class="text-2xl font-black mb-4 text-white transition-colors duration-300" style={`--hover-color: ${accentColor}`}>
										{service.title}
									</h3>
									
									<p class="text-zinc-400 text-sm leading-relaxed mb-8">
										{service.hero?.subtitle}
									</p>

									<div class="mt-auto space-y-4">
										<p class="text-[10px] font-bold tracking-widest uppercase text-zinc-500">Services Include:</p>
										<div class="flex flex-wrap gap-2">
											{(service.servicesInclude || []).slice(0, 3).map((item: string) => (
												<span class="px-3 py-1 rounded-full border border-white/5 bg-white/5 text-[10px] text-zinc-300">
													{item}
												</span>
											))}
										</div>

										<div class="pt-6 border-t border-white/5 flex justify-between items-center">
											<a href={`/services/${service.slug}`} class="inline-flex items-center gap-2 text-xs font-bold tracking-widest uppercase text-white hover:text-white/80 transition-colors group/link">
												{service.cta || 'Learn More'} <ChevronRight size={14} class="text-zinc-500 group-hover/link:text-white" />
											</a>
											<a href={`/services/${service.slug}`} class="w-10 h-10 rounded-full border border-white/10 flex items-center justify-center bg-white/5 group-hover:bg-[#1ea99a] group-hover:text-white group-hover:border-[#1ea99a] transition-all">
												<ChevronRight size={18} />
											</a>
										</div>
									</div>
								</div>
							</div>
						);
					})}
				</div>
			</div>
		</div>
	</section>

	<style>
		#services-slider-container {
			-ms-overflow-style: none;
			scrollbar-width: none;
		}
		#services-slider-container::-webkit-scrollbar {
			display: none;
		}
	</style>

	<!-- Why Partner Section -->
	<section class="py-32 bg-zinc-900/50 border-y border-white/5 relative overflow-hidden">
		<div class="container mx-auto px-6">
			<div class="max-w-4xl mb-20 gsap-reveal">
				<h2 class="text-4xl md:text-6xl font-black mb-8 leading-tight">{getSafe(whyPartner, 'title')}</h2>
				<p class="text-xl text-zinc-400 leading-relaxed">
					{getSafe(whyPartner, 'description')}
				</p>
			</div>

			<div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
				{(whyPartner.cards || []).map((card: any) => (
					<div class="p-10 rounded-3xl border border-white/5 bg-white/[0.01] hover:border-white/20 transition-all gsap-reveal">
						<span class="px-3 py-1 rounded-full border border-white/10 text-[10px] font-bold uppercase tracking-widest text-zinc-500 mb-6 inline-block">
							{card.tag}
						</span>
						<h4 class="text-2xl font-bold mb-6">{card.title}</h4>
						<p class="text-zinc-500 leading-relaxed italic">
							{card.description}
						</p>
					</div>
				))}
			</div>

			<div class="mt-20 py-10 border-t border-white/5 flex flex-wrap justify-center gap-10 md:gap-20 grayscale opacity-50">
				{(whyPartner.statsBar || []).map((stat: string) => (
					<div class="text-sm font-bold tracking-widest uppercase">{stat}</div>
				))}
			</div>
			<p class="text-center text-[10px] font-bold tracking-[0.5em] uppercase text-zinc-600 mt-10">
				{getSafe(whyPartner, 'microCopy')}
			</p>
		</div>
	</section>

	<!-- How We Work Section -->
	<section class="py-32 bg-zinc-950">
		<div class="container mx-auto px-6">
			<div class="text-center mb-20 gsap-reveal">
				<h2 class="text-4xl md:text-6xl font-black mb-8 leading-tight">How We Work</h2>
				<p class="text-zinc-500 max-w-2xl mx-auto">A structured, discovery-first approach to delivering measurable business outcomes.</p>
			</div>

			<div class="relative">
				<!-- Connector Line -->
				<div class="absolute top-1/2 left-0 w-full h-px bg-white/5 hidden lg:block -translate-y-1/2"></div>
				
				<div class="grid lg:grid-cols-5 gap-8 relative z-10">
					{howWeWork.map((step: any, index: number) => (
						<div class="p-8 rounded-3xl bg-zinc-900 border border-white/5 relative group hover:border-white/20 transition-all gsap-reveal">
							<div class="w-12 h-12 rounded-full bg-white text-black flex items-center justify-center font-black mb-8 group-hover:scale-110 transition-transform">
								{index + 1}
							</div>
							<h4 class="text-xl font-bold mb-4">{step.title}</h4>
							<p class="text-zinc-500 text-sm leading-relaxed">{step.desc}</p>
						</div>
					))}
				</div>
			</div>
		</div>
	</section>

	<!-- Counters Section -->
	<section class="py-32 border-y border-white/5 bg-zinc-950">
		<div class="container mx-auto px-6">
			<div class="text-center mb-20 gsap-reveal">
				<h2 class="text-4xl md:text-5xl font-black mb-4">Delivering Measurable Results</h2>
				<p class="text-zinc-500 tracking-widest uppercase text-xs font-bold">Trusted by enterprises across the nation</p>
			</div>
			<div class="grid grid-cols-2 lg:grid-cols-3 gap-12">
				{counters.map((counter: any) => (
					<div class="text-center gsap-reveal">
						<div class="text-6xl md:text-8xl font-black mb-4 tracking-tighter counter-value" data-target={counter.value}>
							0{counter.suffix}
						</div>
						<div class="text-xs font-bold tracking-[0.3em] uppercase text-zinc-500">
							{counter.label}
						</div>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- Industries & FAQ Section -->
	<section class="py-32 bg-zinc-950">
		<div class="container mx-auto px-6">
			<div class="grid lg:grid-cols-2 gap-20">
				<!-- Industries -->
				<div class="gsap-reveal">
					<h2 class="text-4xl font-black mb-12">Industries We Serve</h2>
					<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
						{industries.map((industry: string) => (
							<div class="flex items-center gap-4 p-4 rounded-2xl border border-white/5 bg-white/[0.01]">
								<div class="w-2 h-2 rounded-full bg-zinc-600"></div>
								<span class="text-zinc-300 font-medium">{industry}</span>
							</div>
						))}
					</div>
				</div>

				<!-- FAQ -->
				<div class="gsap-reveal">
					<h2 class="text-4xl font-black mb-12">Frequently Asked Questions</h2>
					<div class="space-y-4">
						{faqs.map((faq: any, index: number) => (
							<details class="group p-6 rounded-2xl border border-white/5 bg-white/[0.01] hover:border-white/10 transition-all cursor-pointer">
								<summary class="list-none flex justify-between items-center font-bold text-lg text-zinc-300">
									{faq.q}
									<Plus size={20} class="group-open:rotate-45 transition-transform" />
								</summary>
								<p class="mt-6 text-zinc-500 leading-relaxed">
									{faq.a}
								</p>
							</details>
						))}
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Final CTA Section -->
	<section class="py-40 relative overflow-hidden bg-white text-black">
		<div class="container mx-auto px-6 text-center relative z-10">
			<h2 class="text-5xl md:text-8xl font-black tracking-tighter mb-12 max-w-4xl mx-auto leading-tight">
				Let's Build Success Together.
			</h2>
			<p class="text-xl text-black/60 max-w-2xl mx-auto mb-16 font-medium">
				Whether you're hiring talent, growing your brand, adopting new technology, investing in property, or switching to solar energy, ViYukti is here to help.
			</p>
			
			<div class="flex flex-col sm:flex-row gap-6 justify-center">
				<a href="/contact-us?subject=Consultation" class="px-10 py-6 rounded-full bg-black text-white font-black tracking-widest uppercase text-sm hover:scale-105 transition-transform flex items-center justify-center gap-3">
					<Phone size={20} /> Schedule Consultation
				</a>
				<a href="/contact-us?subject=Proposal" class="px-10 py-6 rounded-full border border-black/10 font-black tracking-widest uppercase text-sm hover:bg-black/5 transition-all flex items-center justify-center gap-3">
					<Mail size={20} /> Request Proposal
				</a>
				<a href="https://wa.me/XXXXXXXXXX" class="px-10 py-6 rounded-full border border-black/10 font-black tracking-widest uppercase text-sm hover:bg-black/5 transition-all flex items-center justify-center gap-3">
					<MessageSquare size={20} /> Talk to an Expert
				</a>
			</div>
		</div>
	</section>

	<Footer />
</BaseLayout>

<script>
	import gsap from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	gsap.registerPlugin(ScrollTrigger);

	function initCounters() {
		const counters = document.querySelectorAll('.counter-value');
		
		counters.forEach((el: any) => {
			const targetValue = parseInt(el.getAttribute('data-target'));
			const suffix = el.innerText.replace(/[0-9]/g, '') || '';
			
			gsap.fromTo(el, 
				{ innerText: 0 },
				{
					scrollTrigger: {
						trigger: el,
						start: 'top 92%',
						toggleActions: 'play none none none'
					},
					innerText: targetValue,
					duration: 2.5,
					snap: { innerText: 1 },
					ease: 'power4.out',
					onUpdate: function() {
						el.innerText = Math.floor(this.targets()[0].innerText) + suffix;
					}
				}
			);
		});
	}

    function initWhoWeAre() {
        gsap.fromTo('.who-we-are-card', 
            { y: 50, opacity: 0 },
            {
                y: 0,
                opacity: 1,
                duration: 1.5,
                stagger: 0.2,
                ease: 'expo.out',
                scrollTrigger: {
                    trigger: '.who-we-are-card',
                    start: 'top 85%',
                    toggleActions: 'play none none none'
                }
            }
        );
    }

    function initHeroSlider() {
		const slides = document.querySelectorAll('.hero-slide');
		const dots = document.querySelectorAll('.slider-dot');
		if (slides.length === 0) return;

		let currentSlide = 0;
		let intervalId: any = null;

		function showSlide(index: number) {
			slides.forEach((slide: any, i) => {
				const img = slide.querySelector('.slide-image');
				if (i === index) {
					slide.classList.add('opacity-100', 'z-10');
					slide.classList.remove('opacity-0', 'z-0');
					if (img) {
						img.style.transform = 'scale(1.05)';
						setTimeout(() => {
							img.style.transform = 'scale(1.15)';
						}, 50);
					}
				} else {
					slide.classList.remove('opacity-100', 'z-10');
					slide.classList.add('opacity-0', 'z-0');
					if (img) {
						img.style.transform = 'scale(1.05)';
					}
				}
			});

			dots.forEach((dot: any, i) => {
				if (i === index) {
					dot.classList.add('bg-white', 'w-6');
					dot.classList.remove('bg-white/30');
				} else {
					dot.classList.remove('bg-white', 'w-6');
					dot.classList.add('bg-white/30');
				}
			});

			currentSlide = index;
		}

		function nextSlide() {
			const next = (currentSlide + 1) % slides.length;
			showSlide(next);
		}

		function startAutoPlay() {
			stopAutoPlay();
			intervalId = setInterval(nextSlide, 5000);
			
			// Initial Ken Burns trigger
			const activeImg = slides[currentSlide]?.querySelector('.slide-image') as HTMLElement;
			if (activeImg) {
				activeImg.style.transform = 'scale(1.15)';
			}
		}

		function stopAutoPlay() {
			if (intervalId) {
				clearInterval(intervalId);
			}
		}

		dots.forEach((dot: any, i) => {
			dot.addEventListener('click', () => {
				showSlide(i);
				startAutoPlay();
			});
		});

		startAutoPlay();
	}

	function initServicesSlider() {
		const container = document.getElementById('services-slider-container');
		const track = document.getElementById('services-slider-track');
		if (!container || !track) return;

		let isDragging = false;
		let startX = 0;
		let scrollLeft = 0;
		let autoplaySpeed = 0.8; // Slow, smooth auto-slide right-to-left
		let animationFrameId: any = null;

		let oneSetWidth = track.scrollWidth / 2;

		// Initial position
		container.scrollLeft = 0;

		// Handle resize responsiveness
		window.addEventListener('resize', () => {
			oneSetWidth = track.scrollWidth / 2;
		});

		function updateSlider() {
			if (!isDragging) {
				container.scrollLeft += autoplaySpeed;

				// Infinite wrapping checks (right-to-left)
				if (container.scrollLeft >= oneSetWidth) {
					container.scrollLeft = container.scrollLeft - oneSetWidth;
				} else if (container.scrollLeft <= 0) {
					container.scrollLeft = oneSetWidth;
				}
			}
			animationFrameId = requestAnimationFrame(updateSlider);
		}

		// Dragging support
		const startDrag = (e: any) => {
			isDragging = true;
			container.classList.add('cursor-grabbing');
			container.classList.remove('cursor-grab');
			startX = (e.pageX || e.touches[0].pageX) - container.offsetLeft;
			scrollLeft = container.scrollLeft;
		};

		const stopDrag = () => {
			isDragging = false;
			container.classList.remove('cursor-grabbing');
			container.classList.add('cursor-grab');
		};

		const doDrag = (e: any) => {
			if (!isDragging) return;
			e.preventDefault();
			const x = (e.pageX || e.touches[0].pageX) - container.offsetLeft;
			const walk = (x - startX) * 1.5; // Sensitivity multiplier
			let targetScroll = scrollLeft - walk;

			// Wrapping during dragging to prevent hitting edges (right-to-left context)
			if (targetScroll >= oneSetWidth) {
				targetScroll = targetScroll - oneSetWidth;
				startX = x;
				scrollLeft = targetScroll;
			} else if (targetScroll <= 0) {
				targetScroll = oneSetWidth + targetScroll;
				startX = x;
				scrollLeft = targetScroll;
			}

			container.scrollLeft = targetScroll;
		};

		// Mouse Events
		container.addEventListener('mousedown', startDrag);
		container.addEventListener('mouseleave', stopDrag);
		container.addEventListener('mouseup', stopDrag);
		container.addEventListener('mousemove', doDrag);

		// Touch Events
		container.addEventListener('touchstart', startDrag, { passive: true });
		container.addEventListener('touchend', stopDrag);
		container.addEventListener('touchmove', doDrag, { passive: false });

		// Start loop
		updateSlider();

		// Cleanup on Astro transitions
		document.addEventListener('astro:before-preparation', () => {
			if (animationFrameId) cancelAnimationFrame(animationFrameId);
		}, { once: true });
	}

	// Initialize on load and refresh
	document.addEventListener('astro:page-load', () => {
		// Force ScrollTrigger to recalculate positions after content load
		setTimeout(() => {
			ScrollTrigger.refresh();
			initCounters();
            initWhoWeAre();
			initHeroSlider();
			initServicesSlider();
		}, 100);
	});
</script>
