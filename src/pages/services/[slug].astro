---
import BaseLayout from '../../layouts/BaseLayout.astro';
import siteData from '../../data/siteData.json';

export async function getStaticPaths() {
  const services = Object.values(siteData.services);
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
---

<BaseLayout title={service.title} description={service.hero.subtitle}>
    <!-- Industry-Specific Hero -->
    <section class="relative min-h-[90vh] flex items-center justify-center overflow-hidden pt-20">
        <div class="absolute inset-0 z-0">
             <div class="absolute inset-0 bg-gradient-to-b from-transparent via-brand-dark/80 to-brand-dark"></div>
             <!-- In a real app, use service.hero.bgImage here -->
             <div class="w-full h-full bg-slate-900/50 backdrop-blur-3xl animate-pulse"></div>
        </div>

        <div class="container mx-auto px-6 relative z-10 text-center">
            <span class={`inline-block px-4 py-1.5 rounded-full text-sm font-medium border border-white/10 mb-6 bg-white/5 backdrop-blur-md`}>
                ViYukti {service.title}
            </span>
            <h1 class="text-5xl md:text-7xl font-bold tracking-tight mb-6 max-w-4xl mx-auto bg-clip-text text-transparent bg-gradient-to-b from-white to-white/50">
                {service.hero.title}
            </h1>
            <p class="text-lg md:text-xl text-zinc-400 max-w-2xl mx-auto mb-10 leading-relaxed">
                {service.hero.subtitle}
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
                <button class="px-8 py-4 rounded-xl bg-white text-black font-semibold hover:bg-zinc-200 transition-all duration-300">
                    Get Started
                </button>
                <button class="px-8 py-4 rounded-xl border border-white/10 bg-white/5 backdrop-blur-md font-semibold hover:bg-white/10 transition-all duration-300">
                    View Portfolio
                </button>
            </div>
        </div>
    </section>

    <!-- Feature Grid -->
    <section class="py-24 bg-brand-dark relative">
        <div class="container mx-auto px-6">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                {service.features.map((feature) => (
                    <div class="p-8 rounded-2xl border border-white/10 bg-white/[0.02] hover:bg-white/[0.04] transition-all duration-500 group">
                        <div class="w-12 h-12 rounded-lg bg-white/10 mb-6 group-hover:scale-110 transition-transform duration-500"></div>
                        <h3 class="text-xl font-bold mb-3">{feature.title}</h3>
                        <p class="text-zinc-500 leading-relaxed">{feature.desc}</p>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- Dynamic Widget Area (The Dispatcher Logic) -->
    <section class="py-24 border-t border-white/5 bg-zinc-950/50">
        <div class="container mx-auto px-6 text-center">
            <h2 class="text-3xl font-bold mb-12">Industry Specific Solutions</h2>
            <div class="p-12 rounded-3xl border border-dashed border-white/10 min-h-[300px] flex items-center justify-center">
                {service.id === 'solar_services' && <p>Solar Savings Calculator Coming Soon...</p>}
                {service.id === 'recruitment' && <p>Job Board Filter Coming Soon...</p>}
                {service.id === 'digital_marketing' && <p>Animated Performance Metrics Coming Soon...</p>}
                {/* Add more conditions for other IDs */}
                {!['solar_services', 'recruitment', 'digital_marketing'].includes(service.id) && <p>Premium {service.title} Module Loading...</p>}
            </div>
        </div>
    </section>
</BaseLayout>
