---
import BaseLayout from '../layouts/BaseLayout.astro';
import siteData from '../data/siteData.json';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import { Image } from 'astro:assets';
import contactImg from '../assets/contact us.jpg';
import { Phone, Mail, MapPin, Clock, Plus, ChevronRight, Send, Briefcase, Globe, ShieldCheck, ChevronDown } from 'lucide-astro';

const { globalContact, contactPage } = siteData;

// Safely access data
const getSafe = (obj: any, path: string, fallback: any = "") => {
  return path.split('.').reduce((acc, part) => acc && acc[part], obj) || fallback;
};

const serviceOptions = [
    { value: "recruitment", label: "Recruitment & Staffing" },
    { value: "digital_marketing", label: "Digital Marketing" },
    { value: "it_development", label: "IT Development & Support" },
    { value: "corporate_gifting", label: "Corporate Gifting" },
    { value: "real_estate", label: "Real Estate" },
    { value: "solar_services", label: "Solar Installation & Services" },
    { value: "other", label: "Other Inquiry" }
];
---

<BaseLayout title="Contact Us" description={getSafe(contactPage, 'hero.description')}>
    <Navigation />
    
    <!-- Hero Section -->
    <header class="relative pt-40 pb-20 overflow-hidden">
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-full bg-gradient-to-b from-blue-500/5 to-transparent pointer-events-none"></div>
        <div class="container mx-auto px-6 relative z-10 text-center">
            <span class="inline-block px-4 py-1.5 rounded-full text-xs font-bold tracking-widest uppercase border border-white/10 mb-8 bg-white/5 text-zinc-400 gsap-reveal">
                {getSafe(contactPage, 'hero.title')}
            </span>
            <h1 class="text-5xl md:text-8xl font-black tracking-tighter mb-8 leading-tight">
                {getSafe(contactPage, 'hero.subtitle')}
            </h1>
            <p class="text-xl text-zinc-400 max-w-3xl mx-auto mb-12 leading-relaxed gsap-reveal">
                {getSafe(contactPage, 'hero.description')}
            </p>
            <div class="p-8 rounded-3xl bg-white/[0.02] border border-white/5 max-w-4xl mx-auto italic text-zinc-500 gsap-reveal">
                "{getSafe(contactPage, 'hero.philosophy')}"
            </div>
        </div>
    </header>

    <!-- Help Vertical Grid -->
    <section class="py-24 bg-zinc-950">
        <div class="container mx-auto px-6">
            <div class="text-center mb-16 gsap-reveal">
                <h2 class="text-3xl md:text-5xl font-black mb-6">{getSafe(contactPage, 'intro.title')}</h2>
                <p class="text-zinc-500 max-w-2xl mx-auto">{getSafe(contactPage, 'intro.text')}</p>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                {(contactPage.helpVerticals || []).map((vertical) => (
                    <div class="p-8 rounded-3xl border border-white/5 bg-white/[0.01] hover:border-white/03 transition-all gsap-reveal group">
                        <div class="w-12 h-12 rounded-2xl bg-white/5 flex items-center justify-center mb-6 group-hover:bg-white group-hover:text-black transition-all">
                            {vertical.id === 'recruitment' && <Briefcase size={24} />}
                            {vertical.id === 'marketing' && <Globe size={24} />}
                            {vertical.id === 'it' && <Send size={24} />}
                            {vertical.id === 'gifting' && <ShieldCheck size={24} />}
                            {vertical.id === 'realestate' && <MapPin size={24} />}
                            {vertical.id === 'solar' && <Clock size={24} />}
                        </div>
                        <h4 class="text-xl font-bold mb-4 text-white">{vertical.title}</h4>
                        <p class="text-zinc-500 text-sm leading-relaxed">{vertical.desc}</p>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- Main Contact & Form Section -->
    <section class="py-32 bg-zinc-950 border-t border-white/5" id="message">
        <div class="container mx-auto px-6">
            <div class="grid lg:grid-cols-12 gap-12 items-start">
                <!-- Image Column (Premium Portrait Anchor) -->
                <div class="lg:col-span-4 gsap-reveal h-full">
                    <div class="relative h-full min-h-[600px] lg:min-h-[800px] rounded-[3rem] overflow-hidden border border-white/10 bg-white/5 group">
                        <div class="absolute inset-0 bg-gradient-to-t from-zinc-950/80 via-transparent to-transparent z-10 opacity-60 group-hover:opacity-100 transition-opacity duration-700"></div>
                        <div class="w-full h-full" style="mask-image: linear-gradient(to right, black 80%, transparent 100%); -webkit-mask-image: linear-gradient(to right, black 80%, transparent 100%);">
                            <Image 
                                src={contactImg} 
                                alt="Contact ViYukti Team" 
                                class="object-cover w-full h-full grayscale-[0.4] group-hover:grayscale-0 group-hover:scale-105 transition-all duration-[2s] ease-out"
                            />
                        </div>
                        <div class="absolute bottom-12 left-10 z-20">
                            <span class="inline-block px-3 py-1 rounded-full text-[9px] font-black uppercase tracking-[0.2em] bg-white/10 backdrop-blur-md text-white/70 mb-4 border border-white/5">Dedicated Support</span>
                            <p class="text-3xl font-black text-white leading-tight">We're here to<br/>help you grow.</p>
                        </div>
                    </div>
                </div>

                <!-- Info Column -->
                <div class="lg:col-span-3 space-y-12 gsap-reveal lg:pt-10">
                    <div>
                        <h3 class="text-3xl font-black mb-10 tracking-tight">Contact Information</h3>
                        <div class="space-y-8">
                            <div class="flex items-start gap-4">
                                <div class="w-10 h-10 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center shrink-0">
                                    <MapPin size={20} class="text-zinc-400" />
                                </div>
                                <div>
                                    <p class="text-[9px] uppercase tracking-widest font-black text-zinc-600 mb-1">Corporate Office</p>
                                    <p class="text-sm text-white font-medium">{globalContact.address}</p>
                                </div>
                            </div>
                            <div class="flex items-start gap-4">
                                <div class="w-10 h-10 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center shrink-0">
                                    <Phone size={20} class="text-zinc-400" />
                                </div>
                                <div>
                                    <p class="text-[9px] uppercase tracking-widest font-black text-zinc-600 mb-1">Call Us</p>
                                    <p class="text-sm text-white font-medium">{globalContact.phone}</p>
                                </div>
                            </div>
                            <div class="flex items-start gap-4">
                                <div class="w-10 h-10 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center shrink-0">
                                    <Mail size={20} class="text-zinc-400" />
                                </div>
                                <div>
                                    <p class="text-[9px] uppercase tracking-widest font-black text-zinc-600 mb-1">Email Us</p>
                                    <p class="text-sm text-white font-medium">{globalContact.email}</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="p-8 rounded-[2rem] bg-white/[0.02] border border-white/5">
                        <h4 class="text-xl font-bold mb-6 flex items-center gap-3">
                            <Clock size={20} class="text-zinc-500" /> {contactPage.businessHours.title}
                        </h4>
                        <div class="space-y-4">
                            <div class="border-b border-white/5 pb-4">
                                <p class="text-[10px] text-zinc-500 uppercase tracking-wider mb-1">{contactPage.businessHours.support.label}</p>
                                <p class="text-xs font-bold text-white">{contactPage.businessHours.support.days}</p>
                                <p class="text-[10px] text-zinc-600">{contactPage.businessHours.support.time}</p>
                            </div>
                            <div class="border-b border-white/5 pb-4">
                                <p class="text-[10px] text-zinc-500 uppercase tracking-wider mb-1">{contactPage.businessHours.sales.label}</p>
                                <p class="text-xs font-bold text-white">{contactPage.businessHours.sales.days}</p>
                                <p class="text-[10px] text-zinc-600">{contactPage.businessHours.sales.time}</p>
                            </div>
                            <div>
                                <p class="text-[10px] text-zinc-500 uppercase tracking-wider mb-1">{contactPage.businessHours.online.label}</p>
                                <p class="text-xs font-bold text-white">{contactPage.businessHours.online.desc}</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Premium Dark Form Column -->
                <div class="lg:col-span-5 p-10 md:p-12 rounded-[3rem] bg-zinc-900 border border-white/5 gsap-reveal relative overflow-hidden">
                    <div class="absolute top-0 right-0 w-64 h-64 bg-blue-500/5 blur-[80px] -mr-32 -mt-32 pointer-events-none"></div>
                    <h3 class="text-3xl font-black mb-4 text-white">Send Us a Message</h3>
                    <p class="text-zinc-500 mb-10">Fill out our contact form, and one of our specialists will get back to you as soon as possible.</p>
                    
                    <form action={globalContact.formEndpoint} method="POST" class="space-y-6 relative z-10">
                        <input type="hidden" name="access_key" value={globalContact.web3FormsAccessKey} />
                        <input type="hidden" name="subject" value="New Inquiry from ViYukti.com" />
                        
                        <div class="space-y-2">
                            <label class="text-[10px] uppercase tracking-widest font-black text-zinc-600 ml-2">Full Name</label>
                            <input type="text" name="name" required placeholder="John Doe" class="w-full px-8 py-5 rounded-2xl bg-white/[0.03] border border-white/5 focus:border-white/20 transition-all outline-none text-white placeholder:text-zinc-700" />
                        </div>

                        <div class="space-y-2">
                            <label class="text-[10px] uppercase tracking-widest font-black text-zinc-600 ml-2">Company Name</label>
                            <input type="text" name="company" placeholder="Your Company Ltd" class="w-full px-8 py-5 rounded-2xl bg-white/[0.03] border border-white/5 focus:border-white/20 transition-all outline-none text-white placeholder:text-zinc-700" />
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div class="space-y-2">
                                <label class="text-[10px] uppercase tracking-widest font-black text-zinc-600 ml-2">Phone Number</label>
                                <input type="tel" name="phone" required placeholder="+91 XXXXX XXXXX" class="w-full px-8 py-5 rounded-2xl bg-white/[0.03] border border-white/5 focus:border-white/20 transition-all outline-none text-white placeholder:text-zinc-700" />
                            </div>
                            <div class="space-y-2">
                                <label class="text-[10px] uppercase tracking-widest font-black text-zinc-600 ml-2">Email Address</label>
                                <input type="email" name="email" required placeholder="john@company.com" class="w-full px-8 py-5 rounded-2xl bg-white/[0.03] border border-white/5 focus:border-white/20 transition-all outline-none text-white placeholder:text-zinc-700" />
                            </div>
                        </div>

                        <!-- Advanced Custom Dropdown -->
                        <div class="space-y-2 relative" id="custom-dropdown-container">
                            <label class="text-[10px] uppercase tracking-widest font-black text-zinc-600 ml-2">Service Required</label>
                            <input type="hidden" name="service" id="service-input" value="general" />
                            
                            <button type="button" id="dropdown-trigger" class="w-full px-8 py-5 rounded-2xl bg-white/[0.03] border border-white/5 hover:border-white/20 transition-all outline-none text-white flex items-center justify-between group">
                                <span id="dropdown-label">General Inquiry</span>
                                <ChevronDown size={20} class="text-zinc-600 group-hover:text-white transition-colors dropdown-arrow" />
                            </button>

                            <div id="dropdown-menu" class="absolute top-[calc(100%+8px)] left-0 w-full bg-zinc-800 border border-white/10 rounded-3xl shadow-2xl overflow-hidden opacity-0 scale-95 pointer-events-none z-[100] origin-top">
                                {serviceOptions.map(option => (
                                    <div 
                                        class="px-8 py-4 hover:bg-white/5 cursor-pointer text-zinc-400 hover:text-white transition-colors text-sm font-medium border-b border-white/5 last:border-0 dropdown-option"
                                        data-value={option.value}
                                    >
                                        {option.label}
                                    </div>
                                ))}
                            </div>
                        </div>

                        <div class="space-y-2">
                            <label class="text-[10px] uppercase tracking-widest font-black text-zinc-600 ml-2">Your Message</label>
                            <textarea name="message" rows="4" required placeholder="How can we help you?" class="w-full px-8 py-5 rounded-2xl bg-white/[0.03] border border-white/5 focus:border-white/20 transition-all outline-none text-white placeholder:text-zinc-700 resize-none"></textarea>
                        </div>

                        <div class="pt-4">
                            <button type="submit" class="w-full py-6 rounded-2xl bg-white text-black font-black uppercase tracking-widest hover:scale-[1.02] transition-transform flex items-center justify-center gap-3">
                                Send Message <ChevronRight size={20} />
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </section>

    <!-- Consultation Areas -->
    <section class="py-24 bg-white text-black">
        <div class="container mx-auto px-6">
            <div class="grid lg:grid-cols-2 gap-20 items-center">
                <div class="gsap-reveal">
                    <h2 class="text-4xl md:text-5xl font-black mb-8 leading-tight">{getSafe(contactPage, 'consultation.title')}</h2>
                    <p class="text-xl text-black/60 mb-8 leading-relaxed">{getSafe(contactPage, 'consultation.subtitle')}</p>
                    <p class="text-lg text-black/40 mb-12">{getSafe(contactPage, 'consultation.description')}</p>
                    <div class="p-8 rounded-3xl bg-black text-white font-bold tracking-tight">
                        {getSafe(contactPage, 'consultation.closing')}
                    </div>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    {(contactPage.consultation.areas || []).map(area => (
                        <div class="p-6 rounded-2xl border border-black/10 bg-black/5 flex items-center gap-4 group hover:bg-black hover:text-white transition-all duration-300">
                            <div class="w-2 h-2 rounded-full bg-black group-hover:bg-white transition-colors"></div>
                            <span class="font-bold text-sm tracking-tight">{area}</span>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    </section>

    <!-- Why Trust & FAQ -->
    <section class="py-32 bg-zinc-950 border-t border-white/5">
        <div class="container mx-auto px-6">
            <div class="grid lg:grid-cols-2 gap-24">
                <!-- Trust Reasons -->
                <div class="gsap-reveal">
                    <h2 class="text-4xl font-black mb-12">Why Businesses Trust ViYukti</h2>
                    <div class="space-y-8">
                        {(contactPage.trustReasons || []).map(reason => (
                            <div class="flex gap-6">
                                <div class="shrink-0 w-1 bg-white/10"></div>
                                <div>
                                    <h4 class="text-xl font-bold mb-2 text-white">{reason.title}</h4>
                                    <p class="text-zinc-500 leading-relaxed text-sm">{reason.desc}</p>
                                </div>
                            </div>
                        ))}
                    </div>
                </div>

                <!-- FAQ -->
                <div class="gsap-reveal">
                    <h2 class="text-4xl font-black mb-12">Frequently Asked Questions</h2>
                    <div class="space-y-4">
                        {(contactPage.faqs || []).map((faq) => (
                            <details class="group p-6 rounded-2xl border border-white/5 bg-white/[0.01] hover:border-white/10 transition-all cursor-pointer">
                                <summary class="list-none flex justify-between items-center font-bold text-lg text-zinc-300">
                                    {faq.q}
                                    <Plus size={20} class="group-open:rotate-45 transition-transform" />
                                </summary>
                                <p class="mt-6 text-zinc-500 leading-relaxed text-sm">
                                    {faq.a}
                                </p>
                            </details>
                        ))}
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Partner CTA -->
    <section class="py-40 bg-white text-black relative overflow-hidden">
        <div class="container mx-auto px-6 text-center relative z-10">
            <h2 class="text-5xl md:text-8xl font-black tracking-tighter mb-12 max-w-4xl mx-auto leading-tight">
                Partner with ViYukti.
            </h2>
            <p class="text-xl text-black/60 max-w-3xl mx-auto mb-16 leading-relaxed font-medium">
                At ViYukti, we are passionate about helping businesses succeed through innovative solutions, professional expertise, and dedicated support.
            </p>
            
            <div class="flex flex-col sm:flex-row gap-6 justify-center">
                <a href={`tel:${globalContact.phone}`} class="px-10 py-6 rounded-full bg-black text-white font-black tracking-widest uppercase text-sm hover:scale-105 transition-transform flex items-center justify-center gap-3">
                    <Phone size={20} /> Contact Our Team
                </a>
                <a href="#message" class="px-10 py-6 rounded-full border border-black/10 font-black tracking-widest uppercase text-sm hover:bg-black/5 transition-all flex items-center justify-center gap-3">
                    <Mail size={20} /> Request a Proposal
                </a>
            </div>
            <p class="mt-16 text-zinc-400 font-bold uppercase tracking-[0.3em] text-xs">ViYukti – Your Trusted Partner for Business Growth</p>
        </div>
    </section>

    <Footer />
</BaseLayout>

<script>
    import { gsap } from 'gsap';

    function initCustomDropdown() {
        const trigger = document.getElementById('dropdown-trigger');
        const menu = document.getElementById('dropdown-menu');
        const options = document.querySelectorAll('.dropdown-option');
        const label = document.getElementById('dropdown-label');
        const input = document.getElementById('service-input') as HTMLInputElement;
        const arrow = document.querySelector('.dropdown-arrow');

        let isOpen = false;

        // Smart Routing Pre-fill
        const urlParams = new URLSearchParams(window.location.search);
        const industry = urlParams.get('industry');
        if (industry) {
            const matchedOption = Array.from(options).find((opt: any) => opt.dataset.value === industry) as HTMLElement;
            if (matchedOption && label && input) {
                label.innerText = matchedOption.innerText;
                input.value = industry;
            }
        }

        trigger?.addEventListener('click', (e) => {
            e.stopPropagation();
            isOpen = !isOpen;

            if (isOpen) {
                gsap.to(menu, { opacity: 1, scale: 1, pointerEvents: 'auto', duration: 0.4, ease: 'expo.out' });
                gsap.to(arrow, { rotate: 180, duration: 0.3 });
            } else {
                gsap.to(menu, { opacity: 0, scale: 0.95, pointerEvents: 'none', duration: 0.3, ease: 'power2.in' });
                gsap.to(arrow, { rotate: 0, duration: 0.3 });
            }
        });

        options.forEach(option => {
            option.addEventListener('click', (e: any) => {
                const value = e.target.dataset.value;
                const text = e.target.innerText;
                
                if (label && input) {
                    label.innerText = text;
                    input.value = value;
                }

                isOpen = false;
                gsap.to(menu, { opacity: 0, scale: 0.95, pointerEvents: 'none', duration: 0.3 });
                gsap.to(arrow, { rotate: 0, duration: 0.3 });
            });
        });

        // Close on outside click
        document.addEventListener('click', () => {
            if (isOpen) {
                isOpen = false;
                gsap.to(menu, { opacity: 0, scale: 0.95, pointerEvents: 'none', duration: 0.3 });
                gsap.to(arrow, { rotate: 0, duration: 0.3 });
            }
        });
    }

    document.addEventListener('astro:page-load', () => {
        initCustomDropdown();
    });
</script>
