---
import BaseLayout from '../layouts/BaseLayout.astro';
import siteData from '../data/siteData.json';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';

const { globalContact } = siteData;
---

<BaseLayout title="Contact Us" description="Get in touch with ViYukti for multi-industry solutions.">
    <Navigation />
    
    <main class="pt-32 pb-20">
        <section class="container mx-auto px-6 mb-20">
            <div class="max-w-4xl mx-auto text-center gsap-reveal">
                <h1 class="text-5xl md:text-7xl font-bold mb-8">Let's Build Something<br/><span class="text-zinc-600">Extraordinary.</span></h1>
                <p class="text-xl text-zinc-400">Our experts are ready to architect your next phase of growth across any of our 6 specialized industries.</p>
            </div>
        </section>

        <section class="container mx-auto px-6 grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
            <!-- Contact Info -->
            <div class="space-y-8 gsap-reveal">
                <div class="p-8 rounded-[2rem] border border-white/10 bg-white/[0.02]">
                    <h3 class="text-2xl font-bold mb-8">Contact Information</h3>
                    <div class="space-y-6">
                        <div class="flex items-center gap-6 group">
                            <div class="w-12 h-12 rounded-2xl bg-white/5 border border-white/10 flex items-center justify-center group-hover:bg-white group-hover:text-black transition-all">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                            </div>
                            <div>
                                <p class="text-xs text-zinc-500 uppercase tracking-widest font-bold mb-1">Email Us</p>
                                <p class="text-lg text-white">{globalContact.email}</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-6 group">
                            <div class="w-12 h-12 rounded-2xl bg-white/5 border border-white/10 flex items-center justify-center group-hover:bg-white group-hover:text-black transition-all">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                            </div>
                            <div>
                                <p class="text-xs text-zinc-500 uppercase tracking-widest font-bold mb-1">Call Us</p>
                                <p class="text-lg text-white">{globalContact.phone}</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-6 group">
                            <div class="w-12 h-12 rounded-2xl bg-white/5 border border-white/10 flex items-center justify-center group-hover:bg-white group-hover:text-black transition-all">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                            </div>
                            <div>
                                <p class="text-xs text-zinc-500 uppercase tracking-widest font-bold mb-1">Office</p>
                                <p class="text-lg text-white">{globalContact.address}</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="p-8 rounded-[2rem] border border-white/10 bg-gradient-to-br from-blue-500/10 to-transparent">
                    <h4 class="text-xl font-bold mb-4">Quick Support</h4>
                    <p class="text-zinc-400 mb-6 text-sm">Need immediate assistance? Our support team is available Monday - Friday, 9AM to 6PM IST.</p>
                    <button class="w-full py-4 rounded-xl border border-white/10 bg-white/5 text-sm font-bold hover:bg-white/10 transition-all">Chat with an Expert</button>
                </div>
            </div>

            <!-- Form -->
            <div class="p-10 md:p-12 rounded-[2.5rem] border border-white/10 bg-white/[0.02] backdrop-blur-2xl gsap-reveal">
                <form action={globalContact.formEndpoint} method="POST" class="space-y-6">
                    <input type="hidden" name="access_key" value="YOUR_ACCESS_KEY_HERE" />
                    <input type="hidden" name="subject" value="New Inquiry from ViYukti.com" />
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="space-y-2">
                            <label class="text-[10px] uppercase tracking-widest font-bold text-zinc-500 ml-2">Full Name</label>
                            <input type="text" name="name" required placeholder="John Doe" class="w-full px-6 py-4 rounded-2xl bg-white/5 border border-white/10 focus:border-white transition-all outline-none text-white placeholder:text-zinc-700" />
                        </div>
                        <div class="space-y-2">
                            <label class="text-[10px] uppercase tracking-widest font-bold text-zinc-500 ml-2">Email Address</label>
                            <input type="email" name="email" required placeholder="john@company.com" class="w-full px-6 py-4 rounded-2xl bg-white/5 border border-white/10 focus:border-white transition-all outline-none text-white placeholder:text-zinc-700" />
                        </div>
                    </div>

                    <div class="space-y-2">
                        <label class="text-[10px] uppercase tracking-widest font-bold text-zinc-500 ml-2">Industry of Interest</label>
                        <select name="industry" id="industry-select" class="w-full px-6 py-4 rounded-2xl bg-zinc-900 border border-white/10 focus:border-white transition-all outline-none text-white">
                            <option value="general">General Inquiry</option>
                            <option value="recruitment">Recruitment & Staffing</option>
                            <option value="digital_marketing">Digital Marketing</option>
                            <option value="it_development">IT Development</option>
                            <option value="solar_services">Solar Installation</option>
                            <option value="real_estate">Real Estate</option>
                            <option value="corporate_gifting">Corporate Gifting</option>
                        </select>
                    </div>

                    <div class="space-y-2">
                        <label class="text-[10px] uppercase tracking-widest font-bold text-zinc-500 ml-2">Your Message</label>
                        <textarea name="message" id="message-area" rows="5" required placeholder="Tell us about your project or inquiry..." class="w-full px-6 py-4 rounded-2xl bg-white/5 border border-white/10 focus:border-white transition-all outline-none text-white placeholder:text-zinc-700 resize-none"></textarea>
                    </div>

                    <div class="pt-4">
                        <button type="submit" class="w-full py-5 rounded-2xl bg-white text-black font-black uppercase tracking-widest hover:bg-zinc-200 transition-all hover:scale-[1.02]">
                            Send Message
                        </button>
                    </div>
                </form>
            </div>
        </section>
    </main>

    <Footer />
</BaseLayout>

<script>
    // Smart Routing Logic
    document.addEventListener('astro:page-load', () => {
        const urlParams = new URLSearchParams(window.location.search);
        const industry = urlParams.get('industry');
        const intent = urlParams.get('intent');
        
        const selectElement = document.getElementById('industry-select') as HTMLSelectElement;
        const messageArea = document.getElementById('message-area') as HTMLTextAreaElement;

        if (industry && selectElement) {
            // Find the option that matches the URL parameter and select it
            for (let i = 0; i < selectElement.options.length; i++) {
                if (selectElement.options[i].value === industry) {
                    selectElement.selectedIndex = i;
                    break;
                }
            }
        }

        if (intent === 'catalog' && messageArea) {
             messageArea.value = "I am interested in downloading the premium corporate gifting catalog and exploring bulk order options.";
             // Also auto-select the gifting option if they came from the catalog button
             if (selectElement) {
                 for (let i = 0; i < selectElement.options.length; i++) {
                    if (selectElement.options[i].value === 'corporate_gifting') {
                        selectElement.selectedIndex = i;
                        break;
                    }
                }
             }
        }
    });
</script>
