---
import siteData from '../data/siteData.json';
import { Facebook, Instagram, Linkedin } from 'lucide-astro';
---
<footer class="py-20 bg-brand-dark border-t border-white/5">
    <div class="container mx-auto px-6">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-20">
            <div class="col-span-1 md:col-span-2">
                <a href="/" class="text-3xl font-black tracking-tighter text-white mb-6 inline-block">
                    {siteData.companyName}
                </a>
                <p class="text-zinc-500 max-w-sm leading-relaxed mb-8">
                    {siteData.footer.description}
                </p>
                <div class="flex gap-4">
                    {siteData.globalContact.socials?.linkedin && (
                        <a href={siteData.globalContact.socials.linkedin} target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full border border-white/10 flex items-center justify-center text-zinc-400 hover:text-white hover:border-white hover:bg-white/5 transition-all" aria-label="LinkedIn">
                            <Linkedin size={18} />
                        </a>
                    )}
                    {siteData.globalContact.socials?.facebook && (
                        <a href={siteData.globalContact.socials.facebook} target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full border border-white/10 flex items-center justify-center text-zinc-400 hover:text-white hover:border-white hover:bg-white/5 transition-all" aria-label="Facebook">
                            <Facebook size={18} />
                        </a>
                    )}
                    {siteData.globalContact.socials?.instagram && (
                        <a href={siteData.globalContact.socials.instagram} target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full border border-white/10 flex items-center justify-center text-zinc-400 hover:text-white hover:border-white hover:bg-white/5 transition-all" aria-label="Instagram">
                            <Instagram size={18} />
                        </a>
                    )}
                </div>
            </div>
            
            <div>
                <h5 class="text-white font-bold mb-6">Sectors</h5>
                <ul class="space-y-4">
                    {Object.values(siteData.services).map((service) => (
                        <li><a href={`/services/${service.slug}`} class="text-zinc-500 hover:text-white transition-colors text-sm">{service.title}</a></li>
                    ))}
                </ul>
            </div>

            <div>
                <h5 class="text-white font-bold mb-6">Company</h5>
                <ul class="space-y-4 text-sm text-zinc-500">
                    <li><a href="/about-us" class="hover:text-white transition-colors">About Us</a></li>
                    <li><a href="/contact-us" class="hover:text-white transition-colors">Contact Us</a></li>
                    <li><a href="#" class="hover:text-white transition-colors">Privacy Policy</a></li>
                    <li><a href="#" class="hover:text-white transition-colors">Terms of Service</a></li>
                </ul>
            </div>
        </div>

        <div class="pt-8 border-t border-white/5 flex flex-col md:flex-row justify-between items-center gap-4">
            <p class="text-zinc-600 text-xs">{siteData.footer.copyright}</p>
            <p class="text-zinc-600 text-xs">{siteData.footer.credit}</p>
        </div>
    </div>
</footer>
