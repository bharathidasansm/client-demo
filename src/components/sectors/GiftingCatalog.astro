---
import { Image } from 'astro:assets';
import img1 from '../../assets/corporate gifting (image1).jpg';
import img2 from '../../assets/corporate gifting (image2).jpg';
import img3 from '../../assets/corporate gifting (image3).jpg';
import img4 from '../../assets/corporate gifting (image4).jpg';

const products = [
    {
        id: "exec-kit",
        name: "Onboarding",
        image: img1,
    },
    {
        id: "tech-bundle",
        name: "Tech Gadgets",
        image: img2,
    },
    {
        id: "luxury-box",
        name: "Festive",
        image: img3,
    },
    {
        id: "wellness-set",
        name: "Self-Care",
        image: img4,
    }
];
---

<div class="w-full max-w-6xl mx-auto py-12" id="gifting-catalog">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
        {products.map((product) => (
            <div class="gift-card group relative bg-white/[0.01] border border-white/5 rounded-3xl overflow-hidden gsap-reveal">
                <!-- Product Image Container -->
                <div class="aspect-square overflow-hidden relative">
                    <Image
                        src={product.image}
                        alt={product.name}
                        class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                    />
                    <!-- Overlay with Category Name -->
                    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent flex items-end justify-center p-8 opacity-100 transition-opacity">
                         <h4 class="text-xl font-bold text-white tracking-widest uppercase text-center">{product.name}</h4>
                    </div>
                </div>
            </div>
        ))}
    </div>

    <!-- Quick Contact / Form Trigger -->
    <div class="mt-20 p-12 rounded-[3rem] bg-gradient-to-br from-amber-500/10 to-transparent border border-amber-500/10 text-center gsap-reveal">
        <h3 class="text-3xl font-bold mb-4">Bulk Orders & Custom Branding</h3>
        <p class="text-zinc-400 max-w-2xl mx-auto mb-8">
            Looking for something unique? We offer custom logo engraving and bespoke packaging solutions for large-scale corporate orders.
        </p>
        <a href="/contact-us?industry=corporate_gifting" class="inline-flex items-center justify-center px-10 py-4 rounded-full bg-amber-600 text-white font-bold hover:bg-amber-500 transition-all hover:scale-105">
            Contact Us
        </a>
    </div>
</div>
