---
---
<div class="w-full max-w-4xl mx-auto p-6 md:p-10 rounded-[2.5rem] border border-white/10 bg-white/[0.02] backdrop-blur-xl relative overflow-hidden" id="solar-calc">
    <div class="absolute top-0 right-0 p-6 opacity-[0.05] pointer-events-none">
        <svg class="w-24 h-24 text-emerald-500" fill="currentColor" viewBox="0 0 24 24"><path d="M12 7c-2.76 0-5 2.24-5 5s2.24 5 5 5 5-2.24 5-5-2.24-5-5-5zm0-5C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z"/></svg>
    </div>

    <div class="relative z-10 text-left">
        <div class="mb-10">
            <h3 class="text-2xl md:text-3xl font-black mb-2 tracking-tight">Solar Savings Estimator</h3>
            <p class="text-zinc-500 text-sm md:text-base">Calculate your potential monthly savings with ViYukti Solar.</p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-stretch">
            <div class="lg:col-span-7 space-y-8 flex flex-col justify-center">
                <div class="w-full">
                    <label class="block text-[10px] font-black text-zinc-500 mb-6 uppercase tracking-[0.2em]">Monthly Electricity Bill (₹)</label>
                    <div class="relative px-2">
                        <input 
                            type="range" 
                            id="bill-range" 
                            min="1000" 
                            max="50000" 
                            step="500" 
                            value="5000"
                            class="w-full h-1.5 bg-zinc-800 rounded-lg appearance-none cursor-pointer accent-white"
                        />
                        <div class="flex justify-between mt-4 text-[10px] text-zinc-600 font-bold uppercase tracking-widest">
                            <span>₹1,000</span>
                            <span>₹50,000</span>
                        </div>
                    </div>
                </div>

                <div class="p-6 rounded-2xl bg-white/[0.03] border border-white/5 flex items-center justify-between">
                    <div>
                        <div class="text-zinc-500 text-[10px] font-black uppercase tracking-wider mb-1">Current Bill</div>
                        <div class="text-2xl font-black text-white" id="display-bill">₹5,000</div>
                    </div>
                    <div class="w-10 h-10 rounded-full bg-emerald-500/10 flex items-center justify-center">
                        <div class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></div>
                    </div>
                </div>
            </div>

            <div class="lg:col-span-5">
                <div class="h-full p-8 md:p-10 rounded-[2rem] bg-emerald-500/10 border border-emerald-500/20 relative group overflow-hidden flex flex-col justify-center min-h-[220px]">
                     <div class="absolute inset-0 bg-emerald-500/5 translate-y-full group-hover:translate-y-0 transition-transform duration-700"></div>
                     <div class="relative z-10">
                        <div class="text-emerald-400 text-[10px] font-black uppercase tracking-[0.2em] mb-4">Estimated Monthly Savings</div>
                        <div class="text-4xl md:text-5xl lg:text-6xl font-black text-emerald-400 mb-6 tracking-tighter" id="display-savings">₹4,250</div>
                        <p class="text-emerald-400/60 text-xs leading-relaxed font-medium">
                            Based on current market rates and 85% efficiency offset.
                        </p>
                     </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    import { gsap } from 'gsap';

    document.addEventListener('astro:page-load', () => {
        const range = document.getElementById('bill-range') as HTMLInputElement;
        const displayBill = document.getElementById('display-bill');
        const displaySavings = document.getElementById('display-savings');

        if (range && displayBill && displaySavings) {
            range.addEventListener('input', (e) => {
                const val = parseInt((e.target as HTMLInputElement).value);
                const savings = Math.round(val * 0.85);

                // Animate Bill Display
                displayBill.innerText = `₹${val.toLocaleString()}`;
                
                // Animate Savings with GSAP for "Rolling Numbers" feel
                gsap.to(displaySavings, {
                    innerText: savings,
                    duration: 0.4,
                    snap: { innerText: 1 },
                    ease: "power2.out",
                    onUpdate: function() {
                        displaySavings.innerText = `₹${Math.floor(Number(this.targets()[0].innerText)).toLocaleString()}`;
                    }
                });

                // Subtle scale effect on the savings card
                gsap.to('#solar-calc .bg-emerald-500\\/10', {
                    scale: 1.02,
                    duration: 0.1,
                    yoyo: true,
                    repeat: 1
                });
            });
        }
    });
</script>

<style>
    input[type=range]::-webkit-slider-thumb {
        -webkit-appearance: none;
        appearance: none;
        width: 24px;
        height: 24px;
        background: #fff;
        cursor: pointer;
        border-radius: 50%;
        box-shadow: 0 0 20px rgba(255,255,255,0.4);
    }
</style>
