---
---
<div class="w-full max-w-4xl mx-auto p-8 md:p-12 rounded-[2rem] border border-white/10 bg-white/[0.02] backdrop-blur-xl relative overflow-hidden" id="solar-calc">
    <div class="absolute top-0 right-0 p-8 opacity-10">
        <svg class="w-24 h-24 text-emerald-500" fill="currentColor" viewBox="0 0 24 24"><path d="M12 7c-2.76 0-5 2.24-5 5s2.24 5 5 5 5-2.24 5-5-2.24-5-5-5zm0-5C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z"/></svg>
    </div>

    <div class="relative z-10 text-left">
        <h3 class="text-3xl font-bold mb-2">Solar Savings Estimator</h3>
        <p class="text-zinc-500 mb-10">Calculate your potential monthly savings with ViYukti Solar.</p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
            <div class="space-y-8">
                <div>
                    <label class="block text-sm font-medium text-zinc-400 mb-4 uppercase tracking-wider">Monthly Electricity Bill (₹)</label>
                    <input 
                        type="range" 
                        id="bill-range" 
                        min="1000" 
                        max="50000" 
                        step="500" 
                        value="5000"
                        class="w-full h-2 bg-zinc-800 rounded-lg appearance-none cursor-pointer accent-white"
                    />
                    <div class="flex justify-between mt-2 text-sm text-zinc-600 font-mono">
                        <span>₹1k</span>
                        <span>₹50k</span>
                    </div>
                </div>

                <div class="p-6 rounded-2xl bg-white/5 border border-white/5">
                    <div class="text-zinc-400 text-sm mb-1">Current Bill</div>
                    <div class="text-3xl font-bold" id="display-bill">₹5,000</div>
                </div>
            </div>

            <div class="p-8 rounded-[2rem] bg-emerald-500/10 border border-emerald-500/20 relative group overflow-hidden">
                 <div class="absolute inset-0 bg-emerald-500/5 translate-y-full group-hover:translate-y-0 transition-transform duration-700"></div>
                 <div class="relative z-10">
                    <div class="text-emerald-400 text-sm font-bold uppercase tracking-widest mb-2">Estimated Monthly Savings</div>
                    <div class="text-5xl md:text-6xl font-black text-emerald-400 mb-4" id="display-savings">₹4,250</div>
                    <p class="text-emerald-400/60 text-sm leading-relaxed">
                        Based on current market rates and 85% efficiency offset.
                    </p>
                 </div>
            </div>
        </div>
    </div>
</div>

<script>
    import { gsap } from 'gsap';

    document.addEventListener('astro:page-load', () => {
        const range = document.getElementById('bill-range') as HTMLInputElement;
        const displayBill = document.getElementById('display-bill');
        const displaySavings = document.getElementById('display-savings');

        if (range && displayBill && displaySavings) {
            range.addEventListener('input', (e) => {
                const val = parseInt((e.target as HTMLInputElement).value);
                const savings = Math.round(val * 0.85);

                // Animate Bill Display
                displayBill.innerText = `₹${val.toLocaleString()}`;
                
                // Animate Savings with GSAP for "Rolling Numbers" feel
                gsap.to(displaySavings, {
                    innerText: savings,
                    duration: 0.4,
                    snap: { innerText: 1 },
                    ease: "power2.out",
                    onUpdate: function() {
                        displaySavings.innerText = `₹${Math.floor(Number(this.targets()[0].innerText)).toLocaleString()}`;
                    }
                });

                // Subtle scale effect on the savings card
                gsap.to('#solar-calc .bg-emerald-500\\/10', {
                    scale: 1.02,
                    duration: 0.1,
                    yoyo: true,
                    repeat: 1
                });
            });
        }
    });
</script>

<style>
    input[type=range]::-webkit-slider-thumb {
        -webkit-appearance: none;
        appearance: none;
        width: 24px;
        height: 24px;
        background: #fff;
        cursor: pointer;
        border-radius: 50%;
        box-shadow: 0 0 20px rgba(255,255,255,0.4);
    }
</style>
