---
const itServices = [
    {
        title: "Custom SaaS Development",
        desc: "End-to-end engineering of scalable software-as-a-service platforms.",
        details: ["Multi-tenant Architecture", "Real-time Data Processing", "API First Design", "Serverless Infrastructure"],
        icon: "Code"
    },
    {
        title: "Managed Cloud Infrastructure",
        desc: "Architecting robust, secure, and highly available cloud environments.",
        details: ["AWS/Azure Optimization", "DevOps Automation", "24/7 Monitoring", "Disaster Recovery"],
        icon: "Cloud"
    },
    {
        title: "Enterprise Cybersecurity",
        desc: "Protecting your digital assets with advanced threat detection and mitigation.",
        details: ["Penetration Testing", "Compliance Auditing", "Zero-Trust Security", "Identity Management"],
        icon: "Shield"
    },
    {
        title: "Dedicated IT Support",
        desc: "Seamless technical assistance to ensure zero operational downtime.",
        details: ["Level 1-3 Support", "Hardware Management", "Network Optimization", "SLA-driven Response"],
        icon: "Headphones"
    }
];
---

<div class="w-full max-w-4xl mx-auto space-y-4" id="it-enterprise-breakdown">
    {itServices.map((service, index) => (
        <div class="it-accordion-item border border-white/5 bg-white/[0.01] rounded-[1.5rem] overflow-hidden group hover:border-white/10 transition-colors">
            <button class="w-full p-8 text-left flex items-center justify-between it-accordion-trigger">
                <div class="flex items-center gap-6">
                    <div class="w-12 h-12 rounded-xl bg-cyan-500/10 border border-cyan-500/20 flex items-center justify-center group-hover:bg-cyan-500/20 transition-all">
                        <div class="w-4 h-4 bg-cyan-400 rounded-sm"></div>
                    </div>
                    <div>
                        <h4 class="text-xl font-bold group-hover:text-cyan-400 transition-colors">{service.title}</h4>
                        <p class="text-zinc-500 text-sm mt-1">{service.desc}</p>
                    </div>
                </div>
                <div class="accordion-icon w-6 h-6 flex items-center justify-center relative">
                    <div class="absolute w-full h-0.5 bg-zinc-700 rounded-full transition-transform duration-500"></div>
                    <div class="absolute w-0.5 h-full bg-zinc-700 rounded-full transition-transform duration-500 vertical-line"></div>
                </div>
            </button>
            
            <div class="it-accordion-content h-0 opacity-0 overflow-hidden">
                <div class="px-8 pb-8 pt-2 ml-18">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        {service.details.map((detail) => (
                            <div class="flex items-center gap-3 text-zinc-400">
                                <div class="w-1.5 h-1.5 rounded-full bg-cyan-500/40"></div>
                                <span class="text-sm font-medium">{detail}</span>
                            </div>
                        ))}
                    </div>
                </div>
            </div>
        </div>
    ))}
</div>

<script>
    import { gsap } from 'gsap';

    document.addEventListener('astro:page-load', () => {
        const items = document.querySelectorAll('.it-accordion-item');

        items.forEach(item => {
            const trigger = item.querySelector('.it-accordion-trigger');
            const content = item.querySelector('.it-accordion-content');
            const verticalLine = item.querySelector('.vertical-line');
            const details = item.querySelectorAll('.flex.items-center.gap-3');

            let isOpen = false;

            trigger?.addEventListener('click', () => {
                isOpen = !isOpen;

                if (isOpen) {
                    // Close other open items
                    items.forEach(otherItem => {
                        if (otherItem !== item) {
                            const otherContent = otherItem.querySelector('.it-accordion-content');
                            const otherLine = otherItem.querySelector('.vertical-line');
                            gsap.to(otherContent, { height: 0, opacity: 0, duration: 0.4, ease: "power2.inOut" });
                            gsap.to(otherLine, { rotation: 0, duration: 0.4 });
                            otherItem.classList.remove('is-open');
                        }
                    });

                    // Open this item
                    gsap.to(content, { 
                        height: 'auto', 
                        opacity: 1, 
                        duration: 0.6, 
                        ease: "power3.out",
                        onStart: () => {
                            gsap.from(details, {
                                x: -10,
                                opacity: 0,
                                stagger: 0.05,
                                duration: 0.4,
                                ease: "power2.out"
                            });
                        }
                    });
                    gsap.to(verticalLine, { rotation: 90, duration: 0.5, ease: "back.out(2)" });
                    item.classList.add('is-open');
                } else {
                    gsap.to(content, { height: 0, opacity: 0, duration: 0.4, ease: "power2.inOut" });
                    gsap.to(verticalLine, { rotation: 0, duration: 0.4 });
                    item.classList.remove('is-open');
                }
            });
        });
    });
</script>

<style>
    .it-accordion-item.is-open {
        background: rgba(255, 255, 255, 0.02);
        border-color: rgba(6, 182, 212, 0.2);
    }
    .it-accordion-item.is-open .vertical-line {
        background-color: rgb(34, 211, 238);
    }
    .ml-18 {
        margin-left: 4.5rem;
    }
</style>
