---
import siteData from '../data/siteData.json';
---
<nav class="fixed top-0 left-0 w-full z-50 px-6 py-6">
    <div class="max-w-7xl mx-auto flex items-center justify-between px-8 py-4 rounded-2xl border border-white/10 bg-black/20 backdrop-blur-xl">
        <a href="/" class="text-2xl font-black tracking-tighter text-white hover:text-blue-400 transition-colors">
            {siteData.companyName}
        </a>
        
        <div class="hidden md:flex items-center gap-8">
            <a href="/" class="text-sm font-medium text-zinc-400 hover:text-white transition-colors">Home</a>
            <div class="relative group">
                <button class="text-sm font-medium text-zinc-400 group-hover:text-white transition-colors flex items-center gap-1">
                    Services
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                </button>
                <div class="absolute top-full left-0 pt-4 w-64 opacity-0 translate-y-4 pointer-events-none group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto transition-all duration-300">
                    <div class="p-4 rounded-2xl border border-black/10 dark:border-white/10 bg-white dark:bg-zinc-900 shadow-2xl space-y-2">
                        {Object.values(siteData.services).map((service) => (
                            <a href={`/services/${service.slug}`} class="block p-3 rounded-xl hover:bg-black dark:hover:bg-white/5 text-sm text-zinc-600 dark:text-zinc-400 hover:text-white dark:hover:text-white transition-all">
                                {service.title}
                            </a>
                        ))}
                    </div>
                </div>
            </div>
            <button id="theme-toggle" aria-label="Toggle Theme" class="p-2.5 rounded-xl border border-white/10 bg-white/5 hover:bg-white/10 transition-all text-white flex items-center justify-center">
                <svg id="theme-icon-dark" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
                <svg id="theme-icon-light" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path></svg>
            </button>
            <a href="/contact" class="px-6 py-2.5 rounded-xl bg-white text-black text-sm font-bold hover:bg-zinc-200 transition-all">
                Contact Us
            </a>
        </div>

        <button id="menu-toggle" class="md:hidden text-white relative z-[60] p-2">
            <svg id="hamburger" class="w-6 h-6 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path id="line1" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16"></path>
                <path id="line2" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 12h16"></path>
                <path id="line3" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 18h16"></path>
            </svg>
        </button>
    </div>

    <!-- Mobile Menu Overlay -->
    <div id="mobile-menu" class="fixed inset-0 bg-brand-dark/95 backdrop-blur-2xl z-[55] flex flex-col items-center justify-center translate-y-full opacity-0 pointer-events-none">
        <div class="flex flex-col items-center gap-8 text-center p-6">
            <a href="/" class="mobile-link text-3xl font-bold text-white opacity-0">Home</a>
            <div class="space-y-4">
                <p class="text-[10px] uppercase tracking-[0.3em] text-zinc-500 font-black mb-4 mobile-link opacity-0">Our Sectors</p>
                <div class="grid grid-cols-1 gap-4">
                    {Object.values(siteData.services).map((service) => (
                        <a href={`/services/${service.slug}`} class="mobile-link text-xl text-zinc-400 hover:text-white opacity-0">
                            {service.title}
                        </a>
                    ))}
                </div>
            </div>
            <a href="/contact" class="mobile-link px-10 py-4 rounded-2xl bg-white text-black font-bold text-lg opacity-0">
                Contact Us
            </a>
        </div>
    </div>
</nav>

<script>
    import { gsap } from 'gsap';

    document.addEventListener('astro:page-load', () => {
        // Theme Toggle Logic
        const themeToggle = document.getElementById('theme-toggle');
        const iconDark = document.getElementById('theme-icon-dark');
        const iconLight = document.getElementById('theme-icon-light');

        const updateIcon = () => {
            if (document.documentElement.classList.contains('dark')) {
                iconDark?.classList.remove('hidden');
                iconLight?.classList.add('hidden');
            } else {
                iconLight?.classList.remove('hidden');
                iconDark?.classList.add('hidden');
            }
        };
        
        updateIcon();

        themeToggle?.addEventListener('click', () => {
            const element = document.documentElement;
            element.classList.toggle('dark');
            
            const isDark = element.classList.contains('dark');
            localStorage.setItem('theme', isDark ? 'dark' : 'light');
            updateIcon();
        });

        // Mobile Menu Logic
        const toggle = document.getElementById('menu-toggle');
        const menu = document.getElementById('mobile-menu');
        const links = document.querySelectorAll('.mobile-link');
        const line1 = document.getElementById('line1');
        const line2 = document.getElementById('line2');
        const line3 = document.getElementById('line3');

        let isMenuOpen = false;

        const tl = gsap.timeline({ paused: true });

        tl.to(menu, {
            translateY: 0,
            opacity: 1,
            pointerEvents: 'auto',
            duration: 0.6,
            ease: 'expo.inOut'
        })
        .to(links, {
            opacity: 1,
            y: -20,
            stagger: 0.05,
            duration: 0.4,
            ease: 'power2.out'
        }, "-=0.3");

        toggle?.addEventListener('click', () => {
            isMenuOpen = !isMenuOpen;

            if (isMenuOpen) {
                tl.play();
                // Animate Hamburger to X
                gsap.to(line1, { attr: { d: "M6 18L18 6" }, duration: 0.3 });
                gsap.to(line2, { opacity: 0, duration: 0.3 });
                gsap.to(line3, { attr: { d: "M6 6l12 12" }, duration: 0.3 });
            } else {
                tl.reverse();
                // Animate X back to Hamburger
                gsap.to(line1, { attr: { d: "M4 6h16" }, duration: 0.3 });
                gsap.to(line2, { opacity: 1, duration: 0.3 });
                gsap.to(line3, { attr: { d: "M4 18h16" }, duration: 0.3 });
            }
        });

        // Close menu when a link is clicked
        links.forEach(link => {
            link.addEventListener('click', () => {
                if (isMenuOpen) {
                    isMenuOpen = false;
                    tl.reverse();
                    gsap.to(line1, { attr: { d: "M4 6h16" }, duration: 0.3 });
                    gsap.to(line2, { opacity: 1, duration: 0.3 });
                    gsap.to(line3, { attr: { d: "M4 18h16" }, duration: 0.3 });
                }
            });
        });
    });
</script>
