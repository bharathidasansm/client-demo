---
import siteData from '../data/siteData.json';
import { ViewTransitions } from 'astro:transitions';
import homeBgDefault from '../assets/home.jpg';

interface Props {
	title: string;
	description?: string;
	bgImage?: any;
}

const { title, description = siteData.tagline, bgImage = homeBgDefault } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark text-white selection:bg-white/20">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | {siteData.companyName}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
		
		<!-- Google Analytics -->
		<script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${siteData.globalContact.googleAnalyticsId}`}></script>
		<script is:inline define:vars={{ gaId: siteData.globalContact.googleAnalyticsId }}>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());
			gtag('config', gaId);
		</script>

		<ViewTransitions />
	</head>
	<body class="antialiased overflow-x-hidden text-zinc-900 relative bg-transparent">
		<!-- Global Background Layer -->
		<div class="fixed inset-0 z-[-1] overflow-hidden pointer-events-none bg-slate-50">
			<div id="global-parallax-bg" class="absolute inset-0 w-full h-[120%] bg-cover bg-center grayscale opacity-[0.16] contrast-[1.1] transition-all duration-1000" style={`background-image: url('${bgImage.src}');`}></div>
			<div class="absolute inset-0 bg-slate-50/85 backdrop-blur-[1px]"></div>
		</div>

		<slot />

		<style is:global>
			html {
				scroll-behavior: smooth;
				background-color: #f8fafc;
			}
			body {
				font-family: 'Inter', sans-serif;
				background-color: transparent;
				color: #0f172a;
			}

			/* 1. Global Typography Mapping for Light Theme */
			h1, h2, h3, h4, h5, h6, .text-white {
				color: #0f172a !important; /* Navy/Slate 900 headings */
			}
			.text-zinc-300, .text-zinc-400 {
				color: #334155 !important; /* Slate 700 body text */
			}
			.text-zinc-500 {
				color: #475569 !important; /* Slate 600 captions for higher contrast */
			}
			.text-zinc-400 span {
				color: #334155 !important;
			}

			/* 2. Glassmorphism Card Overrides */
			.bg-zinc-950 {
				background-color: rgba(255, 255, 255, 0.75) !important;
				backdrop-filter: blur(12px);
				border-color: rgba(226, 232, 240, 0.8) !important;
				box-shadow: 0 10px 30px -10px rgba(15, 23, 42, 0.04);
			}
			.bg-zinc-900 {
				background-color: rgba(241, 245, 249, 0.7) !important;
				backdrop-filter: blur(12px);
				border-color: rgba(226, 232, 240, 0.8) !important;
				box-shadow: 0 10px 30px -10px rgba(15, 23, 42, 0.04);
			}
			.bg-black {
				background-color: rgba(255, 255, 255, 0.75) !important;
				backdrop-filter: blur(12px);
				border-color: rgba(226, 232, 240, 0.8) !important;
			}
			.bg-white\/\[0\.01\],
			.bg-white\/\[0\.02\],
			.bg-white\/\[0\.03\] {
				background-color: rgba(255, 255, 255, 0.8) !important;
				backdrop-filter: blur(12px) !important;
				border-color: rgba(226, 232, 240, 0.85) !important;
				box-shadow: 0 10px 30px -10px rgba(15, 23, 42, 0.03) !important;
			}

			/* Dividers & Borders */
			.border-white\/5, .border-white\/10 {
				border-color: rgba(226, 232, 240, 0.85) !important;
			}

			/* 3. Navigation Bar Customizations */
			.bg-black\/20 {
				background-color: rgba(255, 255, 255, 0.55) !important;
				border-color: rgba(226, 232, 240, 0.85) !important;
				box-shadow: 0 8px 32px 0 rgba(15, 23, 42, 0.05);
			}
			.nav-services-text {
				color: #334155 !important;
			}
			.nav-services-text:hover {
				color: #2563eb !important;
			}
			.bg-zinc-900\/90 {
				background-color: rgba(255, 255, 255, 0.95) !important;
				border-color: rgba(226, 232, 240, 0.9) !important;
				box-shadow: 0 20px 40px -15px rgba(15, 23, 42, 0.08);
			}

			/* 4. Footer Overrides */
			.bg-brand-dark {
				background-color: #f1f5f9 !important; /* Soft Slate Footer */
				border-top: 1px solid rgba(226, 232, 240, 0.9) !important;
			}
			.bg-brand-dark .text-white {
				color: #0f172a !important;
			}
			.bg-brand-dark .text-zinc-500, .bg-brand-dark .text-zinc-600 {
				color: #475569 !important;
			}

			/* 5. Alternating High-Contrast sections (Leadership Quote & final CTA) */
			/* We keep these sections high-impact by transforming them to Deep Navy Blue */
			section.bg-white {
				background-color: #1e3a8a !important;
				color: #ffffff !important;
			}
			section.bg-white h2, 
			section.bg-white p, 
			section.bg-white svg,
			section.bg-white div,
			section.bg-white span {
				color: #ffffff !important;
			}
			section.bg-white a.bg-black {
				background-color: #ffffff !important;
				color: #1e3a8a !important;
			}
			section.bg-white a.border-black\/10 {
				border-color: rgba(255, 255, 255, 0.25) !important;
				color: #ffffff !important;
			}
			section.bg-white a.border-black\/10:hover {
				background-color: rgba(255, 255, 255, 0.1) !important;
			}

			/* 6. Buttons & Interactions */
			/* White CTA buttons become blue with white text */
			.bg-white {
				background-color: #2563eb !important;
				color: #ffffff !important;
				transition: background-color 0.3s cubic-bezier(0.4, 0, 0.2, 1), border-color 0.3s ease, transform 0.3s ease !important;
			}
			.bg-white:hover {
				background-color: #1d4ed8 !important;
			}
			.bg-white .text-black {
				color: #ffffff !important;
			}
			.bg-white svg {
				color: #ffffff !important;
			}

			/* Outline CTA buttons */
			.bg-white\/5 {
				background-color: rgba(37, 99, 235, 0.05) !important;
				color: #2563eb !important;
			}
			.bg-white\/5:hover {
				background-color: rgba(37, 99, 235, 0.1) !important;
			}
			.border-white\/10 {
				border-color: rgba(37, 99, 235, 0.18) !important;
			}

			/* 7. Safeguards for white text in explicit dark layout elements */
			.bg-blue-600 .text-white,
			.bg-violet-600 .text-white,
			.bg-fuchsia-600 .text-white,
			.bg-black .text-white {
				color: #ffffff !important;
			}
			
			/* Hero slider label */
			.hero-slide span {
				color: #ffffff !important;
				border-color: rgba(255, 255, 255, 0.2) !important;
				background-color: rgba(0, 0, 0, 0.6) !important;
			}

			/* Custom Scrollbar */
			::-webkit-scrollbar {
				width: 8px;
			}
			::-webkit-scrollbar-track {
				background: #f1f5f9;
			}
			::-webkit-scrollbar-thumb {
				background: #cbd5e1;
				border-radius: 10px;
			}
			::-webkit-scrollbar-thumb:hover {
				background: #94a3b8;
			}
		</style>

		<script>
			import { gsap } from 'gsap';
			import { ScrollTrigger } from 'gsap/ScrollTrigger';

			gsap.registerPlugin(ScrollTrigger);

			// Logic to handle scroll restoration across Astro ViewTransitions
			let scrollPositions: Record<string, number> = {};

			document.addEventListener('astro:before-preparation', () => {
				scrollPositions[window.location.pathname] = window.scrollY;
			});

			function initAnimations() {
				// Kill all existing triggers to prevent stacking/ghosting
				ScrollTrigger.getAll().forEach(t => t.kill());

				// 1. Hero Title Reveal
				const titles = document.querySelectorAll('h1');
				titles.forEach(el => {
					gsap.fromTo(el, 
						{ y: 30, opacity: 0, filter: 'blur(10px)' },
						{ y: 0, opacity: 1, filter: 'blur(0px)', duration: 1.2, ease: 'expo.out' }
					);
				});

				// 2. Staggered Scroll Reveals
				const elements = document.querySelectorAll('.gsap-reveal');
				elements.forEach((el) => {
					gsap.fromTo(el,
						{ y: 30, opacity: 0 },
						{
							y: 0,
							opacity: 1,
							duration: 0.8,
							ease: 'power2.out',
							scrollTrigger: {
								trigger: el,
								start: 'top 88%',
								toggleActions: 'play none none none',
							}
						}
					);
				});

				// 3. Card Hover Animations
				const cards = document.querySelectorAll('.gsap-card');
				cards.forEach(card => {
					card.addEventListener('mouseenter', () => {
						gsap.to(card, { y: -5, borderColor: 'rgba(255,255,255,0.2)', backgroundColor: 'rgba(255,255,255,0.05)', duration: 0.3 });
					});
					card.addEventListener('mouseleave', () => {
						gsap.to(card, { y: 0, borderColor: 'rgba(255,255,255,0.1)', backgroundColor: 'rgba(255,255,255,0.02)', duration: 0.3 });
					});
				});

				// 4. Global Background Parallax
				const bg = document.getElementById('global-parallax-bg');
				if (bg) {
					gsap.to(bg, {
						yPercent: 15,
						ease: "none",
						scrollTrigger: {
							trigger: "body",
							start: "top top",
							end: "bottom bottom",
							scrub: true
						}
					});
				}

				// Force a refresh after a short delay to ensure DOM is settled
				setTimeout(() => {
					ScrollTrigger.refresh();
					// Handle manual restoration if Astro's default fails
					const savedPos = scrollPositions[window.location.pathname];
					if (savedPos !== undefined && window.scrollY === 0 && savedPos > 0) {
						window.scrollTo(0, savedPos);
					}
				}, 150);
			}

			// Core lifecycle hook for Astro ViewTransitions
			document.addEventListener('astro:page-load', initAnimations);
		</script>
	</body>
</html>
