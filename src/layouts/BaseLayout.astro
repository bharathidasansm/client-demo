---
import siteData from '../data/siteData.json';
import { ViewTransitions } from 'astro:transitions';
import homeBgDefault from '../assets/home.jpg';

interface Props {
	title: string;
	description?: string;
	bgImage?: any;
}

const { title, description = siteData.tagline, bgImage = homeBgDefault } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark text-white selection:bg-white/20">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | {siteData.companyName}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Exo:wght@400;500;600;700&family=Fira+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
		
		<!-- Google Analytics -->
		<script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${siteData.globalContact.googleAnalyticsId}`}></script>
		<script is:inline define:vars={{ gaId: siteData.globalContact.googleAnalyticsId }}>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());
			gtag('config', gaId);
		</script>

		<ViewTransitions />
	</head>
	<body class="antialiased overflow-x-hidden text-zinc-300 relative bg-transparent">
		<!-- Global Background Layer (SmartGenesis Theme) -->
		<div class="fixed inset-0 z-[-1] overflow-hidden pointer-events-none bg-[#2f2940]">
			<!-- Radial Slate/Purple Gradient Base -->
			<div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(93,81,114,0.65),rgba(70,63,87,0.85)_50%,rgba(47,41,64,1))]"></div>
			
			<!-- Subtle Grid Pattern overlay -->
			<div class="absolute inset-0 opacity-[0.05]" style="background-image: linear-gradient(rgba(255,255,255,0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.1) 1px, transparent 1px); background-size: 46px 46px;"></div>

			<!-- Dynamic Animated Floating Glowing Orbs -->
			<div class="absolute top-[10%] right-[15%] w-[400px] h-[400px] bg-[#1ea99a]/15 rounded-full blur-[100px] animate-pulse-slow"></div>
			<div class="absolute bottom-[20%] left-[10%] w-[500px] h-[500px] bg-[#8b5cf6]/10 rounded-full blur-[120px] animate-bounce-slow"></div>
			<div class="absolute top-[60%] right-[5%] w-[350px] h-[350px] bg-[#fec624]/10 rounded-full blur-[90px] animate-pulse-slow"></div>

			<!-- Parallax Image Layer (Blended with Base) -->
			<div id="global-parallax-bg" class="absolute inset-0 w-full h-[120%] bg-cover bg-center opacity-[0.2] transition-all duration-1000" style={`background-image: url('${bgImage.src}');`}></div>
			<div class="absolute inset-0 bg-[#2f2940]/80 backdrop-blur-[2px]"></div>
		</div>

		<slot />

		<style is:global>
			@keyframes pulse-slow {
				0%, 100% { transform: scale(1); opacity: 0.15; }
				50% { transform: scale(1.08); opacity: 0.25; }
			}
			@keyframes bounce-slow {
				0%, 100% { transform: translateY(0) scale(1); }
				50% { transform: translateY(-25px) scale(1.03); }
			}
			.animate-pulse-slow {
				animation: pulse-slow 8s ease-in-out infinite;
			}
			.animate-bounce-slow {
				animation: bounce-slow 15s ease-in-out infinite;
			}

			html {
				scroll-behavior: smooth;
				background-color: #2f2940;
			}
			body {
				font-family: 'Fira Sans', sans-serif;
				background-color: transparent;
				color: #d4d4d8;
			}

			/* 1. Global Typography Mapping for Dark Theme */
			h1, h2, h3, h4, h5, h6 {
				font-family: 'Exo', sans-serif;
				color: #ffffff !important;
				letter-spacing: -0.02em;
			}
			.text-white {
				color: #ffffff !important;
			}
			.text-zinc-300 {
				color: #d4d4d8 !important;
			}
			.text-zinc-400 {
				color: #a1a1aa !important;
			}
			.text-zinc-500 {
				color: #71717a !important;
			}

			/* 2. Glassmorphism Card Overrides */
			.bg-zinc-950, .bg-zinc-900, .bg-black {
				background-color: rgba(47, 41, 64, 0.45) !important;
				backdrop-filter: blur(12px) !important;
				border: 1px solid rgba(255, 255, 255, 0.05) !important;
				box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.4) !important;
			}
			.bg-white\/\[0\.01\],
			.bg-white\/\[0\.02\],
			.bg-white\/\[0\.03\] {
				background-color: rgba(255, 255, 255, 0.02) !important;
				backdrop-filter: blur(12px) !important;
				border: 1px solid rgba(255, 255, 255, 0.05) !important;
				box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.4) !important;
			}

			/* Dividers & Borders */
			.border-white\/5, .border-white\/10 {
				border-color: rgba(255, 255, 255, 0.06) !important;
			}

			/* 3. Navigation Bar Customizations */
			.bg-black\/20 {
				background-color: rgba(47, 41, 64, 0.6) !important;
				border-color: rgba(255, 255, 255, 0.08) !important;
				box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.2) !important;
			}
			.nav-services-text {
				color: #d4d4d8 !important;
			}
			.nav-services-text:hover {
				color: #1ea99a !important;
			}
			.bg-zinc-900\/90 {
				background-color: rgba(31, 27, 42, 0.95) !important;
				border-color: rgba(255, 255, 255, 0.08) !important;
				box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.5) !important;
			}

			/* 4. Footer Overrides */
			.bg-brand-dark {
				background-color: rgba(31, 27, 42, 0.8) !important;
				border-top: 1px solid rgba(255, 255, 255, 0.05) !important;
			}
			.bg-brand-dark .text-white {
				color: #ffffff !important;
			}
			.bg-brand-dark .text-zinc-500, .bg-brand-dark .text-zinc-600 {
				color: #a1a1aa !important;
			}

			/* 5. Custom Sections Adaptations (Adapting light content to dark style) */
			section.bg-white {
				background-color: rgba(47, 41, 64, 0.35) !important;
				color: #ffffff !important;
				border-top: 1px solid rgba(255, 255, 255, 0.05) !important;
				border-bottom: 1px solid rgba(255, 255, 255, 0.05) !important;
			}
			section.bg-white h2, 
			section.bg-white p, 
			section.bg-white svg,
			section.bg-white div,
			section.bg-white span,
			section.bg-white label {
				color: #ffffff !important;
			}
			section.bg-white .bg-black\/5 {
				background-color: rgba(255, 255, 255, 0.03) !important;
			}
			section.bg-white .border-black\/10 {
				border-color: rgba(255, 255, 255, 0.08) !important;
			}
			section.bg-white .text-black\/60,
			section.bg-white .text-black\/40 {
				color: #a1a1aa !important;
			}
			
			/* Div elements styled as light card blocks become dark glass */
			div.bg-white.text-black {
				background-color: rgba(255, 255, 255, 0.02) !important;
				border: 1px solid rgba(255, 255, 255, 0.05) !important;
				color: #ffffff !important;
			}
			div.bg-white.text-black h3,
			div.bg-white.text-black p,
			div.bg-white.text-black svg {
				color: #ffffff !important;
			}

			/* 6. Buttons & Interactions */
			/* White CTA links and buttons become brand teal */
			a.bg-white, button.bg-white, section.bg-white a.bg-black {
				background-color: #1ea99a !important;
				color: #ffffff !important;
				transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;
			}
			a.bg-white:hover, button.bg-white:hover, section.bg-white a.bg-black:hover {
				background-color: #168d80 !important;
				transform: translateY(-2px);
				box-shadow: 0 8px 25px rgba(30, 169, 154, 0.3);
			}
			a.bg-white .text-black, button.bg-white .text-black {
				color: #ffffff !important;
			}

			/* Outline CTA buttons */
			.bg-white\/5 {
				background-color: rgba(255, 255, 255, 0.03) !important;
				color: #ffffff !important;
				border: 1px solid rgba(255, 255, 255, 0.08) !important;
			}
			.bg-white\/5:hover {
				background-color: rgba(255, 255, 255, 0.08) !important;
				border-color: rgba(255, 255, 255, 0.2) !important;
			}
			.border-white\/10 {
				border-color: rgba(255, 255, 255, 0.08) !important;
			}

			/* 7. Safeguards for white text in explicit dark layout elements */
			.bg-blue-600 .text-white,
			.bg-violet-600 .text-white,
			.bg-fuchsia-600 .text-white,
			.bg-black .text-white {
				color: #ffffff !important;
			}
			
			/* Hero slider label */
			.hero-slide span {
				color: #ffffff !important;
				border-color: rgba(255, 255, 255, 0.1) !important;
				background-color: rgba(0, 0, 0, 0.7) !important;
			}
			
			/* 8. Image Card Overlay Contrast Protection */
			.property-card h3,
			.property-card span,
			.property-card svg,
			.gift-card h4 {
				color: #ffffff !important;
			}

			/* Custom Scrollbar */
			::-webkit-scrollbar {
				width: 8px;
			}
			::-webkit-scrollbar-track {
				background: #231f30;
			}
			::-webkit-scrollbar-thumb {
				background: rgba(255, 255, 255, 0.1);
				border-radius: 10px;
			}
			::-webkit-scrollbar-thumb:hover {
				background: rgba(255, 255, 255, 0.25);
			}
		</style>

		<script>
			import { gsap } from 'gsap';
			import { ScrollTrigger } from 'gsap/ScrollTrigger';

			gsap.registerPlugin(ScrollTrigger);

			// Logic to handle scroll restoration across Astro ViewTransitions
			let scrollPositions: Record<string, number> = {};

			document.addEventListener('astro:before-preparation', () => {
				scrollPositions[window.location.pathname] = window.scrollY;
			});

			function initAnimations() {
				// Kill all existing triggers to prevent stacking/ghosting
				ScrollTrigger.getAll().forEach(t => t.kill());

				// 1. Hero Title Reveal
				const titles = document.querySelectorAll('h1');
				titles.forEach(el => {
					gsap.fromTo(el, 
						{ y: 30, opacity: 0, filter: 'blur(10px)' },
						{ y: 0, opacity: 1, filter: 'blur(0px)', duration: 1.2, ease: 'expo.out' }
					);
				});

				// 2. Staggered Scroll Reveals
				const elements = document.querySelectorAll('.gsap-reveal');
				elements.forEach((el) => {
					gsap.fromTo(el,
						{ y: 30, opacity: 0 },
						{
							y: 0,
							opacity: 1,
							duration: 0.8,
							ease: 'power2.out',
							scrollTrigger: {
								trigger: el,
								start: 'top 88%',
								toggleActions: 'play none none none',
							}
						}
					);
				});

				// 3. Card Hover Animations
				const cards = document.querySelectorAll('.gsap-card');
				cards.forEach(card => {
					card.addEventListener('mouseenter', () => {
						gsap.to(card, { y: -5, borderColor: 'rgba(255,255,255,0.2)', backgroundColor: 'rgba(255,255,255,0.05)', duration: 0.3 });
					});
					card.addEventListener('mouseleave', () => {
						gsap.to(card, { y: 0, borderColor: 'rgba(255,255,255,0.1)', backgroundColor: 'rgba(255,255,255,0.02)', duration: 0.3 });
					});
				});

				// 4. Global Background Parallax
				const bg = document.getElementById('global-parallax-bg');
				if (bg) {
					gsap.to(bg, {
						yPercent: 15,
						ease: "none",
						scrollTrigger: {
							trigger: "body",
							start: "top top",
							end: "bottom bottom",
							scrub: true
						}
					});
				}

				// Force a refresh after a short delay to ensure DOM is settled
				setTimeout(() => {
					ScrollTrigger.refresh();
					// Handle manual restoration if Astro's default fails
					const savedPos = scrollPositions[window.location.pathname];
					if (savedPos !== undefined && window.scrollY === 0 && savedPos > 0) {
						window.scrollTo(0, savedPos);
					}
				}, 150);
			}

			// Core lifecycle hook for Astro ViewTransitions
			document.addEventListener('astro:page-load', initAnimations);
		</script>
	</body>
</html>
